{
  "name": "tm-company",
  "version": "0.1.0",
  "description": "Company insights for Torn directors",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite build --watch",
    "build": "eslint src && vite build",
    "release": "vite build && cp dist/tm-company.user.js ../../userscript/tm-company.user.js",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "vite": "^8.3.7",
    "vite-plugin-monkey": "^8.1.1"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.5"
    }
  }
}
