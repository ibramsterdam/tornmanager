        {
          "name": "torn_api.rate_limit",
          "fields": [
            { "field": "COUNTER" }
          ],
          "tags": []
        },
        {
          "name": "torn_api.invalid_key",
          "fields": [
            { "field": "COUNTER" }
          ],
          "tags": []
        }
      ]
    },
    {
