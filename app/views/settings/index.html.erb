<div class="page-header">
  <h1>Settings</h1>
  <p class="page-subtitle">Manage your account and subscription</p>
</div>

<div class="settings-section">
  <div class="settings-top-grid">
    <div>
      <h2>API Key</h2>
      <%= render "api_key_card" %>
    </div>

    <div>
      <h2>Subscription</h2>
      <div class="subscription-card">
        <div class="subscription-status-header">
          <% if @subscribed %>
            <span class="subscription-badge"><span class="pulse-dot pulse-dot-green"></span> Active</span>
          <% else %>
            <span class="subscription-badge subscription-badge-inactive"><span class="pulse-dot pulse-dot-red"></span> Inactive</span>
          <% end %>
        </div>

        <div class="subscription-sources">
          <div class="subscription-source">
            <div class="subscription-source-header">
              <span>Faction</span>
              <% if @faction_sub_active %>
                <span class="subscription-source-infinity">&infin;</span>
              <% elsif @faction && @faction_setup %>
                <span class="error">Expired</span>
              <% else %>
                <span class="text-muted">N/A</span>
              <% end %>
            </div>
            <% if @faction %>
              <p class="subscription-source-detail">
                <%= @faction.name %>
                <% if !@faction_sub_active && @faction_setup %>
                  &middot; ask leadership to extend
                <% elsif !@faction_setup %>
                  &middot; setup not completed
                <% end %>
              </p>
            <% end %>
          </div>

          <div class="subscription-source">
            <div class="subscription-source-header">
              <span>Personal</span>
              <% if @personal_active %>
                <span class="success"><%= @personal_days %> days</span>
              <% else %>
                <span class="text-muted">None</span>
              <% end %>
            </div>
            <div class="subscription-source-detail">
              <%= form_with url: settings_refresh_subscription_path, method: :post do |form| %>
                <% if @can_refresh %>
                  <%= form.submit "Check for Xanax payments",
                      class: "btn btn-sm btn-secondary",
                      data: { turbo_submits_with: "Checking..." } %>
                <% else %>
                  <%= form.submit "Available in #{@seconds_until_refresh}s",
                      class: "btn btn-sm btn-secondary",
                      disabled: true,
                      data: {
                        controller: "refresh-countdown",
                        refresh_countdown_seconds_remaining_value: @seconds_until_refresh
                      } %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <div class="subscription-how">
          <p>Send Xanax to <%= link_to "Bram [2728237]", "https://www.torn.com/profiles.php?XID=2728237", target: "_blank" %>. Each Xanax = <strong>2 weeks</strong> personal balance. Leaders can transfer personal weeks to the faction from <strong>Leadership > Settings</strong>. Payments processed daily at 04:00 TCT.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="settings-section">
  <h2>Your Data</h2>

  <div class="settings-top-grid">
    <div class="info-card">
      <div class="data-stats-list">
        <div class="data-stats-row">
          <span class="data-stats-label">Login Sessions</span>
          <span class="data-stats-value"><%= @sessions_count %></span>
        </div>
        <div class="data-stats-row">
          <span class="data-stats-label">API Call Logs</span>
          <span class="data-stats-value"><%= @api_calls_count %></span>
        </div>
        <div class="data-stats-row">
          <span class="data-stats-label">Subscription Payments</span>
          <span class="data-stats-value"><%= @payments_count %></span>
        </div>
        <div class="data-stats-row">
          <span class="data-stats-label">Subscription Shares Received</span>
          <span class="data-stats-value"><%= @faction_grants_count %></span>
        </div>
      </div>

      <p class="data-stats-footer">
        See the <%= link_to "Privacy Policy", legal_path(anchor: "privacy-policy") %> for details on what we collect.
      </p>
    </div>

    <div class="info-card">
      <h3>Manage Your Data</h3>
      <p>Download a complete copy of all your data in JSON format, or permanently delete everything we've collected.</p>

      <div class="data-actions">
        <%= link_to "Export Data", settings_export_data_path, class: "btn-outline", data: { turbo: false } %>

        <%= button_to "Delete Data", settings_purge_data_path,
            method: :delete,
            class: "btn-danger",
            data: { turbo_confirm: "Are you sure? This will delete all your collected data and sign you out. Your subscription will be preserved." } %>
      </div>

      <p class="data-stats-footer">Deleting data will sign you out. Your subscription will be preserved.</p>
    </div>
  </div>
</div>
