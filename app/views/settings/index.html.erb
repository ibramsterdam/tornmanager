<div class="page-header">
  <h1>Settings</h1>
  <p class="page-subtitle">Manage your account and subscription</p>
</div>

<div class="settings-section">
  <div class="settings-top-grid">
    <div>
      <h2>API Key</h2>
      <%= render "api_key_card" %>
    </div>

    <div>
      <h2>Subscription Status</h2>
      <div class="subscription-card">
        <% if @subscribed %>
          <div class="subscription-active">
            <div class="subscription-badge">✓ Active Subscriber</div>
            <div class="subscription-days"><%= @days_remaining %> days remaining</div>
            <div class="subscription-expires">Expires: <%= Current.user.subscription_expires_at.strftime("%d %B %Y") %></div>
          </div>
        <% else %>
          <div class="subscription-inactive">
            <div class="subscription-badge subscription-badge-inactive">Not Subscribed</div>
            <p>You don't have an active subscription.</p>
          </div>
        <% end %>

        <%= form_with url: settings_refresh_subscription_path, method: :post do |form| %>
          <% if @can_refresh %>
            <%= form.submit "Check for New Payments", 
                class: "btn-secondary",
                data: { turbo_submits_with: "Checking..." } %>
          <% else %>
            <%= form.submit "Available in #{@seconds_until_refresh} seconds",
                class: "btn-secondary",
                disabled: true,
                data: { 
                  controller: "refresh-countdown",
                  refresh_countdown_seconds_remaining_value: @seconds_until_refresh
                } %>
          <% end %>
        <% end %>

        <details class="subscribe-details">
          <summary>How to subscribe<span class="ping-dot"><span class="ping-ring"></span></span></summary>
          <div class="subscribe-details-content">
            <div class="subscribe-method">
              <h4>Xanax Payment (Automated)</h4>
              <p>Send Xanax to <%= link_to "Bram [2728237]", "https://www.torn.com/profiles.php?XID=2728237", target: "_blank" %>.</p>
              <p>Each Xanax sent = <strong>2 week</strong> of subscription.</p>
              <p class="text-muted">Payments are automatically processed daily at 4 AM TCT. Use the "Check for New Payments" button above to refresh immediately.</p>
            </div>

            <div class="subscribe-method">
              <h4>Faction Sharing</h4>
              <p>Any faction member with dashboard access can share their own subscription time with the entire faction from the faction settings page.</p>
              <p>The shared time is deducted from the sharer's balance and distributed evenly across all members.</p>
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</div>

<div class="settings-section">
  <h2>Browser Extension</h2>
  <div class="info-card">
    <h3>Torn Manager Userscript</h3>
    <p>Install the Torn Manager companion script to enhance your Torn experience directly in the browser. It adds ranked war stats overlays, member details, and more — right on torn.com.</p>
    <p>Requires <%= link_to "Tampermonkey", "https://www.tampermonkey.net/", target: "_blank" %> or <%= link_to "Violentmonkey", "https://violentmonkey.github.io/", target: "_blank" %>.</p>
    <%= link_to "View Userscript Page", userscript_path, class: "btn-primary" %>
  </div>
</div>

<div class="settings-section">
  <h2>Your Data</h2>

  <div class="settings-top-grid">
    <div class="info-card">
      <div class="data-stats-list">
        <div class="data-stats-row">
          <span class="data-stats-label">Login Sessions</span>
          <span class="data-stats-value"><%= @sessions_count %></span>
        </div>
        <div class="data-stats-row">
          <span class="data-stats-label">API Call Logs</span>
          <span class="data-stats-value"><%= @api_calls_count %></span>
        </div>
        <div class="data-stats-row">
          <span class="data-stats-label">Subscription Payments</span>
          <span class="data-stats-value"><%= @payments_count %></span>
        </div>
        <div class="data-stats-row">
          <span class="data-stats-label">Subscription Shares Received</span>
          <span class="data-stats-value"><%= @faction_grants_count %></span>
        </div>
      </div>

      <p class="data-stats-footer">
        See the <%= link_to "Privacy Policy", legal_path(anchor: "privacy-policy") %> for details on what we collect.
      </p>
    </div>

    <div class="info-card">
      <h3>Manage Your Data</h3>
      <p>Download a complete copy of all your data in JSON format, or permanently delete everything we've collected.</p>

      <div class="data-actions">
        <%= link_to "Export Data", settings_export_data_path, class: "btn-outline", data: { turbo: false } %>

        <%= button_to "Delete Data", settings_purge_data_path,
            method: :delete,
            class: "btn-danger",
            data: { turbo_confirm: "Are you sure? This will delete all your collected data and sign you out. Your subscription will be preserved." } %>
      </div>

      <p class="data-stats-footer">Deleting data will sign you out. Your subscription will be preserved.</p>
    </div>
  </div>
</div>
