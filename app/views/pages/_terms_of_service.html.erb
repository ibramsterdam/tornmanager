  <h1 class="legal-document-title">Terms of Service</h1>
  <p class="legal-document-subtitle">Last updated: <%= Date.today.strftime("%d %B %Y") %></p>
  <section class="content-section">
    <h2 id="tos-acceptance">Acceptance of Terms</h2>
    <p>
      By accessing and using TornManager, you accept and agree to be bound by these Terms of Service and my 
      <a href="#privacy-policy">Privacy Policy</a>. If you do not agree to these terms, please do not use my service.
    </p>
