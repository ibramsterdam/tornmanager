    <h2 id="rtos-subscription">Subscription Model</h2>
    <p>
      Recruiter requires an active subscription, obtained by sending Xanax to
      <%= link_to "Bram [2728237]", "https://www.torn.com/profiles.php?XID=2728237", target: "_blank" %>. Each
