<div class="admin-stats">
  <div class="admin-stats-header">
    <%= link_to "← Admin", admin_dashboard_path, class: "back-link" %>
    <h1>Conspiracy Intelligence Agency</h1>
    <span class="admin-stats-asof">Elimination tracker for <%= @setting.team_name %></span>
  </div>

  <%= render "elimination_dashboard/status_panels",
    setting: @setting,
    bot_token_present: @bot_token_present,
    start_path: start_admin_eliminations_path,
    stop_path: stop_admin_eliminations_path %>

  <% if @latest_snapshots.any? %>
    <div class="admin-stats-panel" style="margin-bottom: var(--space-3, 12px);">
      <h2>Standings <span class="admin-stats-hint">captured <%= @latest_snapshots.first.captured_at.utc.strftime("%d %b %H:%M:%S") %> TCT · <%= number_with_delimiter(@snapshot_count) %> rows stored</span></h2>
      <table class="admin-stats-table elim-table">
        <thead>
          <tr>
            <th>#</th><th>Team</th>
            <th class="num">Tickets</th><th class="num">Lives</th><th class="num">Wins</th><th class="num">Losses</th>
          </tr>
        </thead>
        <tbody>
          <% @latest_snapshots.each_with_index do |snapshot, index| %>
            <tr class="<%= "ours" if snapshot.name == @setting.team_name %> <%= "eliminated" if snapshot.eliminated? %>">
              <td><%= snapshot.eliminated? ? "—" : index + 1 %></td>
              <td><%= snapshot.name %><%= " ◂ us" if snapshot.name == @setting.team_name %><%= " · eliminated" if snapshot.eliminated? %></td>
              <td class="num"><%= number_with_delimiter(snapshot.tickets) %></td>
              <td class="num"><%= snapshot.lives %></td>
              <td class="num"><%= number_with_delimiter(snapshot.wins) %></td>
              <td class="num"><%= number_with_delimiter(snapshot.losses) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="admin-stats-panel" style="margin-bottom: var(--space-3, 12px);">
    <h2>Test notifications <span class="admin-stats-hint">sends mock data to the configured channels</span></h2>
    <div class="elim-test-buttons">
      <% Elimination::Demo::KINDS.each do |kind| %>
        <%= button_to kind.humanize, test_admin_eliminations_path(kind: kind), method: :post, class: "btn-secondary" %>
      <% end %>
    </div>
  </div>

  <%= form_with model: @setting, url: admin_eliminations_path, method: :patch do |form| %>
    <% if @setting.errors.any? %>
      <div class="flash flash-alert">
        <ul>
          <% @setting.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="elim-form-columns">
      <div class="admin-stats-panel">
        <h2>Discord</h2>

        <div class="form-group">
          <%= form.label :alerts_channel_id, "Alerts channel ID", class: "form-label" %>
          <%= form.text_field :alerts_channel_id, class: "form-input", placeholder: "Right-click channel → Copy Channel ID" %>
          <p class="form-help">Every bot message goes here: pushes, countdowns, tick reports, standings, eliminations, and health warnings. Needs the bot token in credentials.</p>
        </div>
      </div>

      <div>
        <div class="admin-stats-panel" style="margin-bottom: var(--space-3, 12px);">
          <h2>Alerts</h2>

          <div class="form-group">
            <%= form.label :push_ticket_threshold, "Push threshold (tickets lost)", class: "form-label" %>
            <%= form.number_field :push_ticket_threshold, min: 1, class: "form-input" %>
            <p class="form-help">A push = losing this many tickets inside the window below.</p>
          </div>

          <div class="form-group">
            <%= form.label :push_window_seconds, "Push window (seconds)", class: "form-label" %>
            <%= form.number_field :push_window_seconds, min: 2, class: "form-input" %>
          </div>

          <div class="form-group">
            <%= form.label :push_resolve_seconds, "Push over after (seconds quiet)", class: "form-label" %>
            <%= form.number_field :push_resolve_seconds, min: 30, class: "form-input" %>
          </div>

          <div class="form-group">
            <%= form.label :countdown_bottom_ranks, "Countdown when within bottom", class: "form-label" %>
            <%= form.number_field :countdown_bottom_ranks, min: 1, class: "form-input" %>
            <p class="form-help">2 = warn when we are last or second to last before a tick.</p>
          </div>

          <div class="form-group">
            <%= form.label :standings_interval_minutes, "Standings every (minutes)", class: "form-label" %>
            <%= form.number_field :standings_interval_minutes, min: 5, class: "form-input" %>
          </div>

          <div class="form-group">
            <%= form.label :life_ticks_from, "Life ticks start (TCT)", class: "form-label" %>
            <%= form.datetime_field :life_ticks_from, class: "form-input" %>
            <p class="form-help">No countdown alerts before this moment.</p>
          </div>
        </div>

        <div class="admin-stats-panel">
          <h2>Polling</h2>

          <div class="form-group">
            <%= form.label :team_name, "Our team", class: "form-label" %>
            <%= form.text_field :team_name, class: "form-input" %>
          </div>

          <div class="form-group">
            <%= form.label :api_key, "Torn API key", class: "form-label" %>
            <%= form.text_field :api_key, class: "form-input", autocomplete: "off" %>
            <p class="form-help">Public access is enough. Use a key without a TornManager account so polls skip the api_calls log. Empty = admin key.</p>
          </div>

          <div class="form-group">
            <%= form.label :poll_interval_seconds, "Poll every (seconds)", class: "form-label" %>
            <%= form.number_field :poll_interval_seconds, min: 2, class: "form-input" %>
            <p class="form-help">2s = 30 calls/min, inside the 50/min per-key budget.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="elim-save">
      <%= form.submit "Save settings", class: "btn-primary" %>
    </div>
  <% end %>
</div>
