<div class="page-header">
  <%= link_to "← Back to Admin", admin_dashboard_path, class: "back-link" %>
  <h1>Conspiracy Intelligence Agency</h1>
  <p class="page-subtitle">Elimination tracker: pushes, life ticks, standings, and endpoint health for team <%= @setting.team_name %></p>
</div>

<div class="settings-section">
  <div class="section-header">
    <h2>Status</h2>
  </div>

  <div class="form-field">
    <% if @setting.polling_active? %>
      <p>🟢 Polling every <%= @setting.poll_interval_seconds %>s.
        Last poll: <%= @setting.last_polled_at ? "#{time_ago_in_words(@setting.last_polled_at)} ago" : "never" %>.</p>
      <%= button_to "Stop polling", stop_admin_eliminations_path, method: :post, class: "btn-secondary" %>
    <% else %>
      <p>⚪ Polling stopped.</p>
      <%= button_to "Start polling", start_admin_eliminations_path, method: :post, class: "btn-primary" %>
    <% end %>

    <% if @setting.last_error.present? %>
      <div class="flash flash-alert">Last error: <%= @setting.last_error %></div>
    <% end %>
  </div>

  <% if @latest_snapshots.any? %>
    <table class="admin-table">
      <thead>
        <tr><th>Team</th><th>Tickets</th><th>Lives</th><th>Wins</th><th>Losses</th><th></th></tr>
      </thead>
      <tbody>
        <% @latest_snapshots.each do |snapshot| %>
          <tr>
            <td><%= snapshot.name %><%= " ▸" if snapshot.name == @setting.team_name %></td>
            <td><%= number_with_delimiter(snapshot.tickets) %></td>
            <td><%= snapshot.lives %></td>
            <td><%= number_with_delimiter(snapshot.wins) %></td>
            <td><%= number_with_delimiter(snapshot.losses) %></td>
            <td><%= "eliminated" if snapshot.eliminated? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <small class="form-hint"><%= number_with_delimiter(@snapshot_count) %> snapshot rows stored, latest at <%= @latest_snapshots.first.captured_at.utc.strftime("%d %b %H:%M:%S") %> TCT</small>
  <% end %>
</div>

<div class="settings-section">
  <div class="section-header">
    <h2>Settings</h2>
  </div>

  <%= form_with model: @setting, url: admin_eliminations_path, method: :patch do |form| %>
    <% if @setting.errors.any? %>
      <div class="flash flash-alert">
        <ul>
          <% @setting.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-field">
      <%= form.label :team_name, "Our team" %>
      <%= form.text_field :team_name, class: "form-input" %>
      <small class="form-hint">Exact team name as returned by the elimination endpoint</small>
    </div>

    <div class="form-field">
      <%= form.label :api_key, "Torn API key" %>
      <%= form.text_field :api_key, class: "form-input", autocomplete: "off" %>
      <small class="form-hint">Public access is enough. Use a key that is not linked to a TornManager account so polls skip the api_calls log. Empty falls back to the admin key.</small>
    </div>

    <div class="form-field">
      <%= form.label :alerts_channel_id, "Alerts channel ID" %>
      <%= form.text_field :alerts_channel_id, class: "form-input" %>
      <small class="form-hint">Used when the CIA bot is invited to the server and discord.cia_bot_token is set in credentials. Takes priority over the webhook.</small>
    </div>

    <div class="form-field">
      <%= form.label :standings_channel_id, "Standings channel ID" %>
      <%= form.text_field :standings_channel_id, class: "form-input" %>
      <small class="form-hint">Optional separate channel for standings. Empty uses the alerts channel.</small>
    </div>

    <div class="form-field">
      <%= form.label :alerts_webhook_url, "Alerts webhook URL" %>
      <%= form.text_field :alerts_webhook_url, class: "form-input", autocomplete: "off" %>
      <small class="form-hint">Webhook fallback for pushes, countdowns, tick reports, eliminations, and health warnings when no bot is configured</small>
    </div>

    <div class="form-field">
      <%= form.label :standings_webhook_url, "Standings webhook URL" %>
      <%= form.text_field :standings_webhook_url, class: "form-input", autocomplete: "off" %>
      <small class="form-hint">Optional separate channel for the hourly standings table. Empty uses the alerts webhook.</small>
    </div>

    <div class="form-field">
      <%= form.label :role_id, "Role ID to ping" %>
      <%= form.text_field :role_id, class: "form-input" %>
      <small class="form-hint">Discord role ID pinged for pushes on us, countdowns, and our life losses</small>
    </div>

    <div class="form-field">
      <%= form.label :push_ticket_threshold, "Push threshold (tickets)" %>
      <%= form.number_field :push_ticket_threshold, min: 1, class: "form-input" %>
      <small class="form-hint">Tickets a team must lose inside the window to count as a push</small>
    </div>

    <div class="form-field">
      <%= form.label :push_window_seconds, "Push window (seconds)" %>
      <%= form.number_field :push_window_seconds, min: 2, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= form.label :push_resolve_seconds, "Push resolve after (seconds)" %>
      <%= form.number_field :push_resolve_seconds, min: 30, class: "form-input" %>
      <small class="form-hint">Quiet time before a push is marked as over</small>
    </div>

    <div class="form-field">
      <%= form.label :countdown_bottom_ranks, "Countdown when within bottom" %>
      <%= form.number_field :countdown_bottom_ranks, min: 1, class: "form-input" %>
      <small class="form-hint">2 = alert when we are last or second to last</small>
    </div>

    <div class="form-field">
      <%= form.label :standings_interval_minutes, "Standings interval (minutes)" %>
      <%= form.number_field :standings_interval_minutes, min: 5, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= form.label :poll_interval_seconds, "Poll interval (seconds)" %>
      <%= form.number_field :poll_interval_seconds, min: 2, class: "form-input" %>
      <small class="form-hint">2s = 30 calls/min, inside the 50/min per-key budget</small>
    </div>

    <div class="form-field">
      <%= form.label :life_ticks_from, "Life ticks start (TCT)" %>
      <%= form.datetime_field :life_ticks_from, class: "form-input" %>
      <small class="form-hint">Countdown alerts stay silent before this moment</small>
    </div>

    <div class="form-actions">
      <%= form.submit "Save settings", class: "btn-primary" %>
    </div>
  <% end %>
</div>
