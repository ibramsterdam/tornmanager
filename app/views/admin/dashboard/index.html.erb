<div class="page-header">
  <h1>Admin Dashboard</h1>
  <p class="page-subtitle">Manage subscriptions and factions</p>
</div>

<div class="admin-cards">
  <a href="<%= admin_stats_path %>" class="admin-card">
    <div class="admin-card-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="20" x2="18" y2="10"></line>
        <line x1="12" y1="20" x2="12" y2="4"></line>
        <line x1="6" y1="20" x2="6" y2="14"></line>
      </svg>
    </div>
    <h2>Stats</h2>
    <p>System overview: users, snapshots, data coverage, and health metrics.</p>
  </a>

  <a href="<%= admin_subscriptions_path %>" class="admin-card">
    <div class="admin-card-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
    </div>
    <h2>Subscriptions</h2>
    <p>Manage user subscriptions, grant faction subscriptions, and view payment history.</p>
  </a>

  <a href="<%= admin_factions_path %>" class="admin-card">
    <div class="admin-card-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
    </div>
    <h2>Factions</h2>
    <p>Manage tracked factions for personal stats collection and sync faction memberships.</p>
  </a>

  <a href="<%= admin_api_logs_path %>" class="admin-card">
    <div class="admin-card-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="12" y1="18" x2="12" y2="12"></line>
        <line x1="9" y1="15" x2="15" y2="15"></line>
      </svg>
    </div>
    <h2>API Logs</h2>
    <p>Monitor API calls made with the ApplicationOwner key and track usage patterns.</p>
  </a>
</div>
