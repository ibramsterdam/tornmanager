<%= link_to "← Back to Admin", admin_dashboard_path, class: "back-link" %>

<div class="page-header">
  <h1>Snapshot Management</h1>
  <p class="page-subtitle">Monitor and backfill missing personal stat snapshots</p>
</div>

<% if flash[:notice] %>
  <div class="flash-notice"><%= flash[:notice] %></div>
<% end %>

<div class="stats-section">
  <h2>Coverage Summary</h2>
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-value"><%= @summary[:tracked_users] %></div>
      <div class="stat-label">Tracked Users</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= number_with_delimiter(@summary[:total_expected]) %></div>
      <div class="stat-label">Expected Snapshots</div>
    </div>
    <div class="stat-card">
      <div class="stat-value success"><%= number_with_delimiter(@summary[:total_existing]) %></div>
      <div class="stat-label">Existing Snapshots</div>
    </div>
    <div class="stat-card">
      <div class="stat-value <%= @summary[:total_missing] > 0 ? 'warning' : 'success' %>"><%= number_with_delimiter(@summary[:total_missing]) %></div>
      <div class="stat-label">Missing Snapshots</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= @summary[:coverage_percent] %>%</div>
      <div class="stat-label">Coverage Rate</div>
    </div>
  </div>
</div>

<div class="stats-section">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <h2 style="margin: 0;">Users With Missing Snapshots (<%= @users_with_gaps.size %>)</h2>
    <% if @users_with_gaps.any? %>
      <%= button_to "Backfill All", backfill_all_admin_snapshot_management_index_path, method: :post, class: "btn-small btn-primary", data: { turbo_confirm: "Backfill all #{@users_with_gaps.size} users? This will schedule #{@users_with_gaps.sum { |d| d[:missing_count] } * 2} API calls." } %>
    <% end %>
  </div>

  <% if @users_with_gaps.any? %>
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>User</th>
            <th>Faction</th>
            <th>Missing</th>
            <th>Oldest Gap</th>
            <th>Latest Snapshot</th>
            <th>Actions</th>
          </tr>
        </thead>
          <% @users_with_gaps.each do |data| %>
            <tbody data-controller="backfill-row">
              <tr data-backfill-row-target="row">
                <td>
                  <a href="https://www.torn.com/profiles.php?XID=<%= data[:user].torn_id %>" target="_blank" class="player-link">
                    <%= data[:user].name %>
                  </a>
                  <span class="text-muted">[<%= data[:user].torn_id %>]</span>
                </td>
                <td>
                  <% if data[:user].faction %>
                    <%= data[:user].faction.name %>
                  <% else %>
                    <span class="text-muted">-</span>
                  <% end %>
                </td>
                <td>
                  <span class="badge <%= data[:missing_count] > 10 ? 'badge-warning' : 'badge-info' %>">
                    <%= data[:missing_count] %> days
                  </span>
                </td>
                <td><%= data[:oldest_missing]&.strftime("%d-%m-%Y") || "-" %></td>
                <td><%= data[:latest_snapshot]&.strftime("%d-%m-%Y") || "Never" %></td>
                <td>
                  <%= button_to "Backfill", 
                      backfill_user_admin_snapshot_management_path(data[:user]), 
                      method: :post,
                      class: "btn-small btn-primary",
                      data: { action: "click->backfill-row#remove" } %>
                  
                  <button type="button" 
                          class="btn-small btn-secondary" 
                          onclick="toggleDetails(<%= data[:user].id %>)">
                    Details
                  </button>
                </td>
              </tr>
              <tr id="details-<%= data[:user].id %>" class="details-row" style="display: none;" data-backfill-row-target="detailsRow">
                <td colspan="6">
                  <div class="missing-dates-container">
                    <strong>Missing dates:</strong>
                    <div class="missing-dates-list">
                      <% data[:missing_dates].first(30).each do |date| %>
                        <span class="date-tag"><%= date.strftime("%d-%m-%Y") %></span>
                      <% end %>
                      <% if data[:missing_dates].size > 30 %>
                        <span class="text-muted">... and <%= data[:missing_dates].size - 30 %> more</span>
                      <% end %>
                    </div>
                  </div>
                </td>
              </tr>
            </tbody>
          <% end %>
      </table>
    </div>
  <% else %>
    <p class="empty-state">All tracked users have complete snapshot coverage!</p>
  <% end %>
</div>

<script>
function toggleDetails(userId) {
  const row = document.getElementById('details-' + userId);
  row.style.display = row.style.display === 'none' ? 'table-row' : 'none';
}
</script>

<style>
  .stats-section {
    background: var(--card-bg, #171717);
    border: 1px solid var(--border-color, #262626);
    border-radius: 8px;
    padding: 24px;
    margin-bottom: 24px;
  }

  .stats-section h2 {
    margin: 0 0 16px 0;
    font-size: 1.25rem;
    color: var(--text-primary, #e5e5e5);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 16px;
  }

  .stat-card {
    background: var(--bg-secondary, #0a0a0a);
    border: 1px solid var(--border-color, #262626);
    border-radius: 8px;
    padding: 20px;
    text-align: center;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary, #e5e5e5);
    font-family: 'Geist Mono', monospace;
  }

  .stat-value.success { color: #22c55e; }
  .stat-value.warning { color: #f59e0b; }
  .stat-value.error { color: #ef4444; }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted, #737373);
    text-transform: uppercase;
    margin-top: 8px;
    letter-spacing: 0.05em;
  }

  .table-container {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .data-table th,
  .data-table td {
    padding: 12px 16px;
    text-align: left;
    border-bottom: 1px solid var(--border-color, #262626);
  }

  .data-table th {
    color: var(--text-muted, #737373);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.75rem;
    background: var(--bg-secondary, #0a0a0a);
  }

  .data-table td {
    color: var(--text-primary, #e5e5e5);
  }

  .player-link {
    color: #60a5fa;
    text-decoration: none;
  }

  .player-link:hover {
    text-decoration: underline;
  }

  .text-muted {
    color: var(--text-muted, #737373);
  }

  .badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: 'Geist Mono', monospace;
  }

  .badge-warning {
    background: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
  }

  .badge-info {
    background: rgba(96, 165, 250, 0.2);
    color: #60a5fa;
  }

  .btn-small {
    padding: 6px 12px;
    font-size: 0.75rem;
    border-radius: 4px;
    cursor: pointer;
    font-family: 'Geist Mono', monospace;
    font-weight: 600;
    border: none;
    margin-right: 4px;
  }

  .btn-primary {
    background: #f5f5f5;
    color: #171717;
  }

  .btn-primary:hover {
    background: #e5e5e5;
  }

  .btn-secondary {
    background: #404040;
    color: #e5e5e5;
    border: 1px solid #525252;
  }

  .btn-secondary:hover {
    background: #525252;
  }

  .details-row td {
    background: var(--bg-secondary, #0a0a0a);
    padding: 16px;
  }

  .missing-dates-container {
    max-height: 200px;
    overflow-y: auto;
  }

  .missing-dates-list {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .date-tag {
    display: inline-block;
    padding: 4px 8px;
    background: var(--card-bg, #171717);
    border: 1px solid var(--border-color, #262626);
    border-radius: 4px;
    font-size: 0.75rem;
    font-family: 'Geist Mono', monospace;
    color: var(--text-muted, #a3a3a3);
  }

  .empty-state {
    text-align: center;
    color: var(--text-muted, #737373);
    padding: 32px;
    font-style: italic;
  }

  .flash-notice {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid #22c55e;
    color: #22c55e;
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 24px;
    font-size: 0.875rem;
  }
</style>
