<tr id="<%= dom_id(faction) %>">
  <td>
    <%= link_to faction.name, "https://www.torn.com/factions.php?step=profile&ID=#{faction.torn_id}", target: "_blank" %>
  </td>
  <td><%= faction.torn_id %></td>
  <td class="member-count">
    <%= faction.users.active.count %><% if faction.users.fallen.any? %> <small style="color:#737373;">(+<%= faction.users.fallen.count %> fallen)</small><% end %>
    <% if faction.users.any? %>
      <button type="button" class="btn-small" onclick="document.getElementById('users-list-<%= faction.id %>').style.display = document.getElementById('users-list-<%= faction.id %>').style.display === 'none' ? 'table-row' : 'none'" style="margin-left:8px; font-size:0.75rem; padding:4px 8px;">View</button>
    <% end %>
  </td>
  <td>
    <small>
      Xanax: <%= faction.xanax_target %>/day<br>
      Energy: <%= faction.energy_refill_target > 0 ? "#{faction.energy_refill_target}/day" : "Disabled" %><br>
      Nerve: <%= faction.nerve_refill_target > 0 ? "#{faction.nerve_refill_target}/day" : "Disabled" %>
    </small>
  </td>
  <td>
    <label class="toggle-switch">
      <input type="checkbox" 
             <%= "checked" if faction.track_stats %>
             data-controller="faction-toggle"
             data-action="change->faction-toggle#toggle"
             data-faction-toggle-url-value="<%= toggle_tracking_admin_faction_path(faction) %>"
             data-faction-toggle-row-value="<%= dom_id(faction) %>">
      <span class="toggle-slider"></span>
    </label>
  </td>
  <td>
    <%= link_to "Edit Targets", edit_admin_faction_path(faction), class: "btn-small" %>
    <%= link_to "Sync", sync_members_admin_faction_path(faction), method: :post, class: "btn-small", data: { turbo_method: :post } %>
    <button type="button" class="btn-small" onclick="document.getElementById('backfill-modal-<%= faction.id %>').style.display='flex'">Backfill Stats</button>
    <%= button_to "Backfill Wars", backfill_wars_admin_faction_path(faction), method: :post, class: "btn-small", data: { turbo_confirm: "Fetch the last 20 ranked wars for '#{faction.name}'?" } %>
    <%= button_to "Delete", admin_faction_path(faction), method: :delete, class: "btn-small btn-small-danger", data: { turbo_confirm: "Are you sure you want to remove '#{faction.name}'?" } %>
  </td>
</tr>

<% if faction.users.any? %>
<tr id="users-list-<%= faction.id %>" style="display:none;">
  <td colspan="6" style="padding:0;">
    <div style="background:#0a0a0a; padding:16px; border-top:1px solid #262626;">
      <h4 style="margin:0 0 12px 0; color:#e5e5e5; font-size:0.875rem; font-weight:600;">Active Members (<%= faction.users.active.count %>)</h4>
      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(250px, 1fr)); gap:8px;">
        <% faction.users.active.order(:name).each do |user| %>
          <div style="background:#171717; padding:12px; border-radius:6px; border:1px solid #262626; display:flex; justify-content:space-between; align-items:center;">
            <span style="color:#e5e5e5; font-size:0.875rem;">
              <%= link_to user.name, "https://www.torn.com/profiles.php?XID=#{user.torn_id}", target: "_blank", style: "color:#e5e5e5; text-decoration:none;" %> 
              <small style="color:#737373;">[<%= user.torn_id %>]</small>
              <% if user.ssl_user? %>
                <span style="margin-left:6px; padding:1px 5px; background:rgba(139,92,246,0.15); color:rgb(167,139,250); border:1px solid rgba(139,92,246,0.3); border-radius:4px; font-size:0.625rem; font-weight:700;">SSL</span>
              <% end %>
            </span>
            <div style="display:flex; gap:6px;">
              <button type="button" 
                      class="btn-small <%= user.ssl_user? ? 'btn-small-active' : '' %>" 
                      id="ssl-toggle-<%= user.id %>"
                      onclick="toggleSsl(<%= faction.torn_id %>, <%= user.id %>)"
                      style="font-size:0.75rem; padding:4px 8px;"
                      title="Toggle Sports Science Lab status">
                SSL
              </button>
              <button type="button" class="btn-small" onclick="document.getElementById('backfill-user-modal-<%= user.id %>').style.display='flex'" style="font-size:0.75rem; padding:4px 8px;">Backfill</button>
            </div>
          </div>
        <% end %>
      </div>
      <% if faction.users.fallen.any? %>
        <h4 style="margin:24px 0 12px 0; color:#737373; font-size:0.875rem; font-weight:600;">Fallen Members (<%= faction.users.fallen.count %>)</h4>
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(250px, 1fr)); gap:8px;">
          <% faction.users.fallen.order(:name).each do |user| %>
            <div style="background:#171717; padding:12px; border-radius:6px; border:1px solid #262626; opacity:0.5;">
              <span style="color:#737373; font-size:0.875rem;">
                <%= link_to user.name, "https://www.torn.com/profiles.php?XID=#{user.torn_id}", target: "_blank", style: "color:#737373; text-decoration:none;" %> 
                <small>[<%= user.torn_id %>]</small>
              </span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </td>
</tr>
<% end %>

<% content_for :modals do %>
  <!-- Faction Backfill Modal -->
  <div id="backfill-modal-<%= faction.id %>" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.75); z-index:1000; align-items:center; justify-content:center; padding:20px;">
    <div style="background:#171717; max-width:500px; width:100%; padding:32px; border-radius:12px; border:1px solid #262626; box-shadow:0 20px 25px -5px rgba(0,0,0,0.5);">
      <h2 style="color:#e5e5e5; margin:0 0 8px 0; font-size:1.5rem; font-weight:600;">Backfill Historical Stats</h2>
      <p style="color:#a3a3a3; margin:0 0 24px 0; font-size:0.875rem;">Faction: <strong style="color:#e5e5e5;"><%= faction.name %></strong> • Members: <strong style="color:#e5e5e5;"><%= faction.users.active.count %></strong></p>
      
      <%= form_with url: backfill_stats_admin_faction_path(faction), method: :post, data: { turbo: false } do |f| %>
        <div style="margin-bottom:24px;">
          <label for="start_date_<%= faction.id %>" style="display:block; margin-bottom:8px; color:#e5e5e5; font-weight:600; font-size:0.875rem;">Start Date</label>
          <%= f.date_field :start_date, id: "start_date_#{faction.id}", value: PersonalStatSnapshot.tracking_start_date, min: PersonalStatSnapshot.tracking_start_date, max: PersonalStatSnapshot.tracking_end_date, style: "width:100%; padding:12px 16px; background:#0a0a0a; border:1px solid #262626; border-radius:8px; color:#e5e5e5; font-family:'Geist Mono',monospace; font-size:0.875rem; color-scheme:dark;" %>
        </div>
        
        <div style="margin-bottom:24px;">
          <label for="end_date_<%= faction.id %>" style="display:block; margin-bottom:8px; color:#e5e5e5; font-weight:600; font-size:0.875rem;">End Date</label>
          <%= f.date_field :end_date, id: "end_date_#{faction.id}", value: PersonalStatSnapshot.tracking_end_date, min: PersonalStatSnapshot.tracking_start_date, max: PersonalStatSnapshot.tracking_end_date, style: "width:100%; padding:12px 16px; background:#0a0a0a; border:1px solid #262626; border-radius:8px; color:#e5e5e5; font-family:'Geist Mono',monospace; font-size:0.875rem; color-scheme:dark;" %>
        </div>
        
        <div style="background:#0a2540; border:1px solid #1e40af; padding:16px; border-radius:8px; margin-bottom:24px;">
          <p style="margin:0; font-size:0.875rem; color:#93c5fd; line-height:1.5;"><strong>Note:</strong> This will backfill 10 stats (xanax, cannabis, energy/nerve refills, boosters, stat enhancers, contracts, crimes, activity time, net worth, money mugged) for all faction members. Jobs will be scheduled at 60 per minute (1 per second) to respect API rate limits.</p>
        </div>
        
        <div style="display:flex; gap:12px; margin-top:32px;">
          <%= f.submit "Queue Backfill Jobs", class: "btn-primary", style: "flex:1; padding:12px 24px; background:#f5f5f5; color:#171717; border:1px solid #f5f5f5; border-radius:8px; font-weight:600; font-size:0.875rem; cursor:pointer; font-family:'Geist Mono',monospace;" %>
          <button type="button" onclick="document.getElementById('backfill-modal-<%= faction.id %>').style.display='none'" style="flex:1; padding:12px 24px; background:#404040; color:white; border:1px solid #525252; border-radius:8px; font-weight:600; font-size:0.875rem; cursor:pointer; font-family:'Geist Mono',monospace;">Cancel</button>
        </div>
      <% end %>
    </div>
  </div>

  <!-- User-specific Backfill Modals (only for active users) -->
  <% faction.users.active.each do |user| %>
    <div id="backfill-user-modal-<%= user.id %>" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.75); z-index:1001; align-items:center; justify-content:center; padding:20px;">
      <div style="background:#171717; max-width:500px; width:100%; padding:32px; border-radius:12px; border:1px solid #262626; box-shadow:0 20px 25px -5px rgba(0,0,0,0.5);">
        <h2 style="color:#e5e5e5; margin:0 0 8px 0; font-size:1.5rem; font-weight:600;">Backfill User Stats</h2>
        <p style="color:#a3a3a3; margin:0 0 24px 0; font-size:0.875rem;">User: <strong style="color:#e5e5e5;"><%= user.name %></strong> [<%= user.torn_id %>]</p>
        
        <%= form_with url: backfill_user_stats_admin_faction_path(faction, user_id: user.id), method: :post, data: { turbo: false } do |f| %>
          <div style="margin-bottom:24px;">
            <label for="user_start_date_<%= user.id %>" style="display:block; margin-bottom:8px; color:#e5e5e5; font-weight:600; font-size:0.875rem;">Start Date</label>
            <%= f.date_field :start_date, id: "user_start_date_#{user.id}", value: PersonalStatSnapshot.tracking_start_date, min: PersonalStatSnapshot.tracking_start_date, max: PersonalStatSnapshot.tracking_end_date, style: "width:100%; padding:12px 16px; background:#0a0a0a; border:1px solid #262626; border-radius:8px; color:#e5e5e5; font-family:'Geist Mono',monospace; font-size:0.875rem; color-scheme:dark;" %>
          </div>
          
          <div style="margin-bottom:24px;">
            <label for="user_end_date_<%= user.id %>" style="display:block; margin-bottom:8px; color:#e5e5e5; font-weight:600; font-size:0.875rem;">End Date</label>
            <%= f.date_field :end_date, id: "user_end_date_#{user.id}", value: PersonalStatSnapshot.tracking_end_date, min: PersonalStatSnapshot.tracking_start_date, max: PersonalStatSnapshot.tracking_end_date, style: "width:100%; padding:12px 16px; background:#0a0a0a; border:1px solid #262626; border-radius:8px; color:#e5e5e5; font-family:'Geist Mono',monospace; font-size:0.875rem; color-scheme:dark;" %>
          </div>
          
          <div style="background:#0a2540; border:1px solid #1e40af; padding:16px; border-radius:8px; margin-bottom:24px;">
            <p style="margin:0; font-size:0.875rem; color:#93c5fd; line-height:1.5;"><strong>Note:</strong> This will backfill 10 stats for this user only. Each date requires up to 2 API calls. Jobs are scheduled at 60 per minute to respect API rate limits.</p>
          </div>
          
          <div style="display:flex; gap:12px; margin-top:32px;">
            <%= f.submit "Queue Backfill", class: "btn-primary", style: "flex:1; padding:12px 24px; background:#f5f5f5; color:#171717; border:1px solid #f5f5f5; border-radius:8px; font-weight:600; font-size:0.875rem; cursor:pointer; font-family:'Geist Mono',monospace;" %>
            <button type="button" onclick="document.getElementById('backfill-user-modal-<%= user.id %>').style.display='none'" style="flex:1; padding:12px 24px; background:#404040; color:white; border:1px solid #525252; border-radius:8px; font-weight:600; font-size:0.875rem; cursor:pointer; font-family:'Geist Mono',monospace;">Cancel</button>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
