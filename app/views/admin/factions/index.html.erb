<div class="page-header">
  <%= link_to "← Back to Admin", admin_dashboard_path, class: "back-link" %>
  <h1>Manage Factions</h1>
  <p class="page-subtitle">Configure which factions have their members' stats tracked</p>
</div>

<div class="settings-section">
  <div class="section-header">
    <h2>Factions</h2>
  </div>

  <%= turbo_frame_tag "add_faction" do %>
    <%= render "form" %>
  <% end %>

  <div class="tos-table">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Torn ID</th>
          <th>Members</th>
          <th>Daily Targets</th>
          <th>Track Stats</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="factions">
        <%= render @factions %>
      </tbody>
    </table>
  </div>

  <%= yield :modals %>

  <% if @factions.empty? %>
    <div class="info-card mt-4">
      <p>No factions added yet. Use the form above to start tracking a faction's members.</p>
    </div>
  <% end %>
</div>
