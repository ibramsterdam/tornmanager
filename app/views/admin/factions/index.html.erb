<div class="page-header">
  <%= link_to "← Back to Admin", admin_dashboard_path, class: "back-link" %>
  <h1>Manage Factions</h1>
  <p class="page-subtitle">Configure which factions have their members' stats tracked</p>
</div>

<div class="settings-section">
  <div class="section-header">
    <h2>Factions</h2>
  </div>

  <%= turbo_frame_tag "add_faction" do %>
    <%= render "form" %>
  <% end %>

  <div class="tos-table">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Torn ID</th>
          <th>Members</th>
          <th>Daily Targets</th>
          <th>Track Stats</th>
          <th>Public Wars</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="factions">
        <%= render @factions %>
      </tbody>
    </table>
  </div>

  <%= yield :modals %>

  <% if @factions.empty? %>
    <div class="info-card mt-4">
      <p>No factions added yet. Use the form above to start tracking a faction's members.</p>
    </div>
  <% end %>
</div>

<script>
  async function togglePublicWars(factionTornId, checked) {
    try {
      const response = await fetch(`/admin/factions/${factionTornId}/toggle_public_wars`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        }
      });

      const data = await response.json();

      if (!data.success) {
        alert('Failed to toggle public wars: ' + (data.error || 'Unknown error'));
        // Revert checkbox
        const checkbox = document.querySelector(`#public-wars-toggle-${factionTornId}`);
        if (checkbox) checkbox.checked = !checked;
      }
    } catch (error) {
      alert('Failed to toggle public wars: ' + error.message);
      // Revert checkbox
      const checkbox = document.querySelector(`#public-wars-toggle-${factionTornId}`);
      if (checkbox) checkbox.checked = !checked;
    }
  }

  async function toggleSsl(factionTornId, userId) {
    const button = document.getElementById(`ssl-toggle-${userId}`);
    const originalText = button.textContent;
    button.textContent = '...';
    button.disabled = true;

    try {
      const response = await fetch(`/admin/factions/${factionTornId}/toggle_ssl?user_id=${userId}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        }
      });

      const data = await response.json();

      if (data.success) {
        button.classList.toggle('btn-small-active', data.ssl_user);
        // Find and update the SSL badge
        const userDiv = button.closest('div[style*="background:#171717"]');
        const nameSpan = userDiv.querySelector('span');
        const existingBadge = nameSpan.querySelector('span[style*="rgb(167,139,250)"]');
        
        if (data.ssl_user && !existingBadge) {
          const badge = document.createElement('span');
          badge.style = 'margin-left:6px; padding:1px 5px; background:rgba(139,92,246,0.15); color:rgb(167,139,250); border:1px solid rgba(139,92,246,0.3); border-radius:4px; font-size:0.625rem; font-weight:700;';
          badge.textContent = 'SSL';
          nameSpan.appendChild(badge);
        } else if (!data.ssl_user && existingBadge) {
          existingBadge.remove();
        }
      } else {
        alert('Failed to toggle SSL: ' + (data.error || 'Unknown error'));
      }
    } catch (error) {
      alert('Failed to toggle SSL: ' + error.message);
    } finally {
      button.textContent = originalText;
      button.disabled = false;
    }
  }
</script>
