<div class="page-header">
  <%= link_to "← Back to Admin", admin_dashboard_path, class: "back-link" %>
  <h1>Subscription Management</h1>
</div>

<div class="form-container">
  <%= form_with url: grant_admin_subscriptions_path, method: :post do |form| %>
    <div class="api-key-form-inline">
      <%= form.select :target_type, [["User", "User"], ["Faction", "Faction"]], {}, class: "api-key-form-input", style: "max-width: 120px;" %>
      <%= form.number_field :torn_id, required: true, min: 1, class: "api-key-form-input", placeholder: "Torn ID", inputmode: "numeric" %>
      <%= form.number_field :weeks, required: true, min: 1, value: 1, class: "api-key-form-input", placeholder: "Weeks", inputmode: "numeric", style: "max-width: 100px;" %>
      <%= form.submit "Grant Subscription", class: "btn-primary" %>
    </div>
  <% end %>
</div>

<div class="table-container" data-controller="collapsible">
  <h2 class="collapsible-header" data-action="click->collapsible#toggle">
    <span data-collapsible-target="icon">▼</span>
    Faction Subscriptions (<%= @faction_subscriptions.count %>)
  </h2>

  <div data-collapsible-target="content">
    <% if @faction_subscriptions.any? %>
      <table>
      <thead>
        <tr>
          <th>FACTION</th>
          <th>MEMBERS</th>
          <th>EXPIRES AT</th>
          <th>DAYS REMAINING</th>
        </tr>
      </thead>
      <tbody>
        <% @faction_subscriptions.each do |sub| %>
          <% faction = sub.subscribable %>
          <% next unless faction %>
          <tr data-controller="subscription-days" data-subscription-days-url-value="<%= update_days_admin_subscription_path(sub) %>">
            <td><%= faction.name %> [<%= faction.torn_id %>]</td>
            <td><%= faction.users.count %></td>
            <td data-subscription-days-target="expiresAt"><%= sub.expires_at.strftime("%d-%m-%Y %H:%M") %></td>
            <td class="days-cell">
              <span data-subscription-days-target="display"><%= sub.days_remaining %> days</span>
              <input type="number"
                     data-subscription-days-target="input"
                     data-action="keypress->subscription-days#keypress"
                     class="days-input"
                     style="display: none;"
                     min="0"
                     value="<%= sub.days_remaining %>">
              <button data-subscription-days-target="button"
                      data-action="click->subscription-days#edit"
                      class="edit-days-btn">Edit</button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% else %>
      <p>No faction subscriptions.</p>
    <% end %>
  </div>
</div>

<div class="table-container" data-controller="collapsible">
  <h2 class="collapsible-header" data-action="click->collapsible#toggle">
    <span data-collapsible-target="icon">▼</span>
    Individual Subscriptions (<%= @individual_subscriptions.count %>)
  </h2>

  <div data-collapsible-target="content">
    <% if @individual_subscriptions.any? %>
      <table>
      <thead>
        <tr>
          <th>PLAYER</th>
          <th>LEVEL</th>
          <th>EXPIRES AT</th>
          <th>DAYS REMAINING</th>
        </tr>
      </thead>
      <tbody>
        <% @individual_subscriptions.each do |sub| %>
          <% user = sub.subscribable %>
          <% next unless user %>
          <tr data-controller="subscription-days" data-subscription-days-url-value="<%= update_days_admin_subscription_path(sub) %>">
            <td>
              <a href="https://www.torn.com/profiles.php?XID=<%= user.torn_id %>" target="_blank" class="player-link"><%= user.name %></a>
            </td>
            <td><%= user.level %></td>
            <td data-subscription-days-target="expiresAt"><%= sub.expires_at.strftime("%d-%m-%Y %H:%M") %></td>
            <td class="days-cell">
              <span data-subscription-days-target="display"><%= sub.days_remaining %> days</span>
              <input type="number"
                     data-subscription-days-target="input"
                     data-action="keypress->subscription-days#keypress"
                     class="days-input"
                     style="display: none;"
                     min="0"
                     value="<%= sub.days_remaining %>">
              <button data-subscription-days-target="button"
                      data-action="click->subscription-days#edit"
                      class="edit-days-btn">Edit</button>
            </td>
            <td>
              <%= button_to "Login as", admin_impersonate_path(user), method: :post, class: "btn btn-sm btn-secondary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% else %>
      <p>No individual subscriptions.</p>
    <% end %>
  </div>
</div>

<div class="table-container" data-controller="collapsible">
  <h2 class="collapsible-header" data-action="click->collapsible#toggle">
    <span data-collapsible-target="icon">▼</span>
    Recent Xanax Payments
  </h2>

  <div data-collapsible-target="content">
    <% if @recent_payments.any? %>
    <table>
      <thead>
        <tr>
          <th>SENDER</th>
          <th>XANAX AMOUNT</th>
          <th>WEEKS GRANTED</th>
          <th>PROCESSED AT</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_payments.each do |payment| %>
          <tr>
            <td>
              <a href="https://www.torn.com/profiles.php?XID=<%= payment.sender.torn_id %>" target="_blank" class="player-link"><%= payment.sender.name %></a>
            </td>
            <td><%= payment.xanax_amount %></td>
            <td><%= payment.weeks_granted %></td>
            <td><%= payment.processed_at.strftime("%d-%m-%Y %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No payments yet.</p>
  <% end %>
  </div>
</div>
