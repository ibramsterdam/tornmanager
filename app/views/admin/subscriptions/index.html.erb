<div class="page-header">
  <%= link_to "&larr; Admin".html_safe, admin_dashboard_path, class: "back-link" %>
  <h1>Subscriptions</h1>
</div>

<div class="admin-sub-grant">
  <%= form_with url: grant_admin_subscriptions_path, method: :post, class: "admin-sub-grant-form" do |form| %>
    <%= form.select :target_type, [["User", "User"], ["Faction", "Faction"]], {}, class: "admin-sub-input admin-sub-input-sm" %>
    <%= form.number_field :torn_id, required: true, min: 1, class: "admin-sub-input", placeholder: "Torn ID", inputmode: "numeric" %>
    <%= form.number_field :weeks, required: true, min: 1, value: 1, class: "admin-sub-input admin-sub-input-sm", placeholder: "Wks", inputmode: "numeric" %>
    <%= form.submit "Grant", class: "btn btn-sm btn-primary" %>
  <% end %>
</div>

<div class="admin-sub-sections">
  <div class="admin-sub-section">
    <h2 class="admin-sub-heading">Factions (<%= @faction_subscriptions.count %>)</h2>
    <% if @faction_subscriptions.any? %>
      <table class="admin-sub-table">
        <thead>
          <tr><th>Faction</th><th>Mbr</th><th>Expires</th><th>Days</th></tr>
        </thead>
        <tbody>
          <% @faction_subscriptions.each do |sub| %>
            <% faction = sub.subscribable %>
            <% next unless faction %>
            <tr data-controller="subscription-days" data-subscription-days-url-value="<%= update_days_admin_subscription_path(sub) %>">
              <td><%= faction.name %></td>
              <td><%= faction.users.count %></td>
              <td data-subscription-days-target="expiresAt" class="<%= 'error' unless sub.active? %>"><%= sub.expires_at.strftime("%d %b %Y") %></td>
              <td class="days-cell">
                <span data-subscription-days-target="display" class="<%= sub.days_remaining < 7 ? 'error' : sub.days_remaining < 14 ? 'warning' : 'success' %>"><%= sub.days_remaining %>d</span>
                <input type="number" data-subscription-days-target="input" data-action="keypress->subscription-days#keypress" class="days-input" style="display: none;" min="0" value="<%= sub.days_remaining %>">
                <button data-subscription-days-target="button" data-action="click->subscription-days#edit" class="edit-days-btn">Edit</button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="admin-sub-empty">No faction subscriptions.</p>
    <% end %>
  </div>

  <div class="admin-sub-section">
    <h2 class="admin-sub-heading">Individuals (<%= @individual_subscriptions.count %>)</h2>
    <% if @individual_subscriptions.any? %>
      <table class="admin-sub-table">
        <thead>
          <tr><th>Player</th><th>Lvl</th><th>Expires</th><th>Days</th><th></th></tr>
        </thead>
        <tbody>
          <% @individual_subscriptions.each do |sub| %>
            <% user = sub.subscribable %>
            <% next unless user %>
            <tr data-controller="subscription-days" data-subscription-days-url-value="<%= update_days_admin_subscription_path(sub) %>">
              <td><a href="https://www.torn.com/profiles.php?XID=<%= user.torn_id %>" target="_blank" class="player-link"><%= user.name %></a></td>
              <td><%= user.level %></td>
              <td data-subscription-days-target="expiresAt" class="<%= 'error' unless sub.active? %>"><%= sub.expires_at.strftime("%d %b %Y") %></td>
              <td class="days-cell">
                <span data-subscription-days-target="display" class="<%= sub.days_remaining < 7 ? 'error' : sub.days_remaining < 14 ? 'warning' : 'success' %>"><%= sub.days_remaining %>d</span>
                <input type="number" data-subscription-days-target="input" data-action="keypress->subscription-days#keypress" class="days-input" style="display: none;" min="0" value="<%= sub.days_remaining %>">
                <button data-subscription-days-target="button" data-action="click->subscription-days#edit" class="edit-days-btn">Edit</button>
              </td>
              <td><%= button_to "Login as", admin_impersonate_path(user), method: :post, class: "btn btn-sm btn-secondary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="admin-sub-empty">No individual subscriptions.</p>
    <% end %>
  </div>
</div>

<% if @recent_payments.any? %>
  <details class="admin-sub-payments">
    <summary class="admin-sub-heading">Recent Payments (<%= @recent_payments.size %>)</summary>
    <table class="admin-sub-table admin-sub-table-compact">
      <thead>
        <tr><th>Sender</th><th>Xanax</th><th>Weeks</th><th>Date</th></tr>
      </thead>
      <tbody>
        <% @recent_payments.each do |payment| %>
          <tr>
            <td><a href="https://www.torn.com/profiles.php?XID=<%= payment.sender.torn_id %>" target="_blank" class="player-link"><%= payment.sender.name %></a></td>
            <td><%= payment.xanax_amount %></td>
            <td><%= payment.weeks_granted %></td>
            <td><%= payment.processed_at.strftime("%d %b %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </details>
<% end %>

<div class="admin-sub-info">
  <p><strong>How it works:</strong> Users send Xanax to Bram [2728237]. Each Xanax grants 2 weeks of personal subscription. From the leadership dashboard, leaders can transfer their personal weeks to extend the faction subscription.</p>
</div>
