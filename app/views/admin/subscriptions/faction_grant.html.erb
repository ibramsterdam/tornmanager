<div class="page-header">
  <%= link_to "← Back to Admin", admin_dashboard_path, class: "back-link" %>
  <h1>Grant Faction Subscriptions</h1>
  <p class="page-subtitle">Grant subscriptions to all members of a faction</p>
</div>

<div class="form-container">
  <%= form_with url: create_faction_grant_admin_subscriptions_path, method: :post do |form| %>
    <div class="form-group">
      <%= form.label :faction_id, "Faction ID" %>
      <%= form.number_field :faction_id, required: true, min: 1, class: "form-input" %>
      <p class="form-help">Enter the Torn faction ID</p>
    </div>
    
    <div class="form-group">
      <%= form.label :weeks, "Weeks to Grant" %>
      <%= form.number_field :weeks, required: true, min: 1, value: 1, class: "form-input" %>
      <p class="form-help">Number of weeks to extend subscriptions for all faction members</p>
    </div>
    
    <div class="form-actions">
      <%= form.submit "Grant Subscriptions", class: "button button-primary" %>
    </div>
  <% end %>
</div>

<div class="info-box">
  <h3>How it works:</h3>
  <ul>
    <li>Fetches all current members of the specified faction</li>
    <li>Creates user records for any members not in the database</li>
    <li>Extends each member's subscription by the specified number of weeks</li>
    <li>Records the grant for tracking purposes</li>
  </ul>
</div>
