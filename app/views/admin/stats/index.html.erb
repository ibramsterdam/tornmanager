<div class="admin-stats">
  <div class="admin-stats-header">
    <%= link_to "&larr; Admin".html_safe, admin_dashboard_path, class: "back-link" %>
    <h1>System Stats</h1>
    <span class="admin-stats-asof">as of <%= Time.current.strftime("%d %b %Y %H:%M") %> TCT &middot; activity metrics cached &le;15 min</span>
  </div>

  <%= turbo_frame_tag "stats-overview", src: admin_stats_section_path(name: "overview") do %>
    <div class="admin-skel">
      <div class="admin-skel-row" style="width: 70%; height: 26px;"></div>
      <div class="admin-skel-row" style="width: 100%; height: 64px;"></div>
    </div>
  <% end %>

  <%= turbo_frame_tag "stats-collection", src: admin_stats_section_path(name: "collection") do %>
    <div class="admin-skel">
      <div class="admin-skel-row" style="width: 30%; height: 20px;"></div>
      <div class="admin-skel-row" style="width: 100%; height: 90px;"></div>
    </div>
  <% end %>

  <%= turbo_frame_tag "stats-api", src: admin_stats_section_path(name: "api") do %>
    <div class="admin-skel">
      <div class="admin-skel-row" style="width: 30%; height: 20px;"></div>
      <div class="admin-skel-row" style="width: 100%; height: 90px;"></div>
    </div>
  <% end %>

  <%= turbo_frame_tag "stats-factions", src: admin_stats_section_path(name: "factions") do %>
    <div class="admin-skel">
      <div class="admin-skel-row" style="width: 30%; height: 20px;"></div>
      <div class="admin-skel-row" style="width: 100%; height: 70px;"></div>
    </div>
  <% end %>

  <%= turbo_frame_tag "stats-volume", src: admin_stats_section_path(name: "volume") do %>
    <div class="admin-skel">
      <div class="admin-skel-row" style="width: 30%; height: 20px;"></div>
      <div class="admin-skel-row" style="width: 100%; height: 70px;"></div>
    </div>
  <% end %>
</div>
