<div class="admin-stats">
  <div class="admin-stats-header">
    <%= link_to "&larr; Admin".html_safe, admin_dashboard_path, class: "back-link" %>
    <h1>Recruiter Pipeline</h1>
    <span class="admin-stats-asof">as of <%= Time.current.strftime("%d %b %Y %H:%M") %> TCT</span>
  </div>

  <%= turbo_frame_tag "recruiter-pipeline", src: admin_recruiter_section_path(name: "pipeline") do %>
    <div class="admin-skel">
      <div class="admin-skel-row" style="width: 30%; height: 20px;"></div>
      <div class="admin-skel-row" style="width: 100%; height: 64px;"></div>
    </div>
  <% end %>

  <%= turbo_frame_tag "recruiter-jobs", src: admin_recruiter_section_path(name: "jobs") do %>
    <div class="admin-skel">
      <div class="admin-skel-row" style="width: 30%; height: 20px;"></div>
      <div class="admin-skel-row" style="width: 100%; height: 64px;"></div>
    </div>
  <% end %>

  <%= turbo_frame_tag "recruiter-keys", src: admin_recruiter_section_path(name: "keys") do %>
    <div class="admin-skel">
      <div class="admin-skel-row" style="width: 30%; height: 20px;"></div>
      <div class="admin-skel-row" style="width: 100%; height: 64px;"></div>
    </div>
  <% end %>

  <%= turbo_frame_tag "recruiter-ratings", src: admin_recruiter_section_path(name: "ratings") do %>
    <div class="admin-skel">
      <div class="admin-skel-row" style="width: 30%; height: 20px;"></div>
      <div class="admin-skel-row" style="width: 100%; height: 64px;"></div>
    </div>
  <% end %>
</div>
