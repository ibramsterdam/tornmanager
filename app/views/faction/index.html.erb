<% if @no_faction %>
  <div class="centered-content">
    <div class="info-card">
      <h2>No Faction</h2>
      <p>You need to be in a faction to view faction stats.</p>
      <p>Join a faction in <%= link_to "Torn", "https://www.torn.com", target: "_blank" %> to access this page.</p>
    </div>
  </div>
<% elsif @tracking_disabled %>
  <div class="centered-content">
    <div class="info-card">
      <h2>Stats Tracking Disabled</h2>
      <p>Your faction (<strong><%= @faction.name %></strong>) does not have stats tracking enabled.</p>
      <p>Contact an administrator to enable stats tracking for your faction.</p>
    </div>
  </div>
<% else %>
  <% backfill_in_progress = @faction.backfill_in_progress? %>
  <%
    def sortable_header(sort_info)
      if sort_info[:current]
        arrow = sort_info[:current_direction] == "asc" ? "▲" : "▼"
        arrow_html = "<span class='sort-arrow active'>#{arrow}</span>"
      else
        arrow_html = "<span class='sort-arrow'>▼</span>"
      end
      # Preserve date filter params and faction_id when sorting
      url_params = { sort: sort_info[:column], direction: sort_info[:direction] }
      url_params[:start_date] = params[:start_date] if params[:start_date].present?
      url_params[:end_date] = params[:end_date] if params[:end_date].present?
      url_params[:faction_id] = params[:faction_id] if params[:faction_id].present?
      link_to "#{sort_info[:label]} #{arrow_html}".html_safe, faction_index_path(url_params), class: "sort-link"
    end
  %>

  <div class="page-header">
    <h1><%= Current.user.admin? ? "Viewing Faction:" : "My Faction:" %> <%= @faction.name %></h1>
    <p class="page-subtitle">Stats tracking for <%= @faction.users.count %> members</p>
  </div>

  <% if backfill_in_progress %>
    <div class="backfill-banner" data-controller="backfill-countdown" data-backfill-countdown-seconds-remaining-value="<%= @faction.backfill_seconds_remaining %>">
      <div class="backfill-banner-content">
        <div class="backfill-banner-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <div class="backfill-banner-text">
          <strong>Fetching historical data</strong>
          <span>Backfilling member stats up until <%= @faction.backfill_target_date&.strftime("%d %B %Y") %>.</span>
          <span>Table will be enabled in: <strong data-backfill-countdown-target="countdown"></strong></span>
        </div>
      </div>
    </div>
  <% end %>

  <div class="table-container <%= 'table-disabled' if backfill_in_progress %>">
    <% if Current.user.admin? %>
      <div class="table-info" style="margin-bottom: 16px;">
        <%= form_with url: faction_index_path, method: :get, class: "table-filter-form" do |form| %>
          <div class="filter-inline">
            <span class="info-label">Switch Faction:</span>
            <%= form.select :faction_id, 
                options_from_collection_for_select(Faction.where(track_stats: true).order(:name), :id, :name, @faction.id),
                {}, 
                { class: "date-input-inline", style: "width: 250px;", onchange: "this.form.submit()" } %>
            <%= hidden_field_tag :start_date, params[:start_date] if params[:start_date].present? %>
            <%= hidden_field_tag :end_date, params[:end_date] if params[:end_date].present? %>
            <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>
            <%= hidden_field_tag :direction, params[:direction] if params[:direction].present? %>
          </div>
        <% end %>
      </div>
    <% end %>
    
    <div class="table-info">
      <%= form_with url: faction_index_path, method: :get, class: "table-filter-form" do |form| %>
        <div class="filter-inline">
          <span class="info-label">Tracking Period:</span>
          
          <div class="date-inputs-inline">
            <%= form.date_field :start_date, 
                value: params[:start_date] || @start_date,
                min: @earliest_date,
                max: PersonalStatSnapshot.tracking_end_date,
                class: "date-input-inline" %>
            
            <span class="date-separator">→</span>
            
            <%= form.date_field :end_date, 
                value: params[:end_date] || @end_date,
                min: @earliest_date,
                max: PersonalStatSnapshot.tracking_end_date,
                class: "date-input-inline" %>
          </div>
          
          <span class="info-days">(<%= @total_days_tracked %> days)</span>
          
          <%= hidden_field_tag :sort, params[:sort] %>
          <%= hidden_field_tag :direction, params[:direction] %>
          <% if Current.user.admin? %>
            <%= hidden_field_tag :faction_id, params[:faction_id] %>
          <% end %>
          
          <button type="submit" class="filter-button-inline">Apply</button>
          <% if params[:start_date].present? || params[:end_date].present? %>
            <%= link_to "Reset", faction_index_path(faction_id: params[:faction_id]), class: "filter-reset-inline" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Compliance Summary -->
    <div class="compliance-summary">
      <div class="target-info">
        <h3>Daily Targets</h3>
        <ul>
          <li><strong>Xanax:</strong> <%= @faction.xanax_target %>/day</li>
          <li><strong>Energy Refills:</strong> <%= @faction.energy_refill_target %>/day</li>
          <li><strong>Nerve Refills:</strong> <%= @faction.nerve_refill_target %>/day</li>
        </ul>
      </div>
      
      <div class="compliance-stats">
        <div class="stat-box compliant">
          <span class="count"><%= @compliant_members_count %></span>
          <span class="label">Compliant</span>
        </div>
        <div class="stat-box warning">
          <span class="count"><%= @warning_members_count %></span>
          <span class="label">Needs Attention</span>
        </div>
        <div class="stat-box danger">
          <span class="count"><%= @non_compliant_members_count %></span>
          <span class="label">Below Target</span>
        </div>
      </div>
    </div>

    <% if @member_rows.empty? %>
      <div class="info-card">
        <p>No data available for the selected period. Members need at least 2 snapshots to calculate gains.</p>
      </div>
    <% else %>
      <table>
        <thead>
          <tr>
            <th>Status</th>
            <th><%= sortable_header(sort_link("name", "MEMBER")) %></th>
            <th><%= sortable_header(sort_link("xanax_daily", "XANAX")) %><br><small>Target: <%= @faction.xanax_target %>/day</small></th>
            <th><%= sortable_header(sort_link("energy_refills_daily", "ENERGY REFILLS")) %><br><small>Target: <%= @faction.energy_refill_target %>/day</small></th>
            <th><%= sortable_header(sort_link("nerve_refills_daily", "NERVE REFILLS")) %><br><small>Target: <%= @faction.nerve_refill_target %>/day</small></th>
            <th><%= sortable_header(sort_link("missions_daily", "CONTRACTS")) %></th>
            <th><%= sortable_header(sort_link("crimes_daily", "CRIMES")) %></th>
            <th><%= sortable_header(sort_link("activity_time_daily", "ACTIVITY")) %><br><small>min/day</small></th>
          </tr>
        </thead>
        <tbody>
          <% @member_rows.each do |row| %>
            <tr class="<%= row_compliance_class(row[:compliance_level]) %>">
              <td class="compliance-badge-cell">
                <span class="compliance-badge <%= row[:compliance_level] %>">
                  <%= compliance_icon(row[:compliance_level]) %>
                </span>
              </td>
              <td>
                <%= link_to row[:name], member_faction_index_path(torn_id: row[:torn_id]), class: "player-link" %>
              </td>
              <td>
                <div class="stat-cell">
                  <span class="stat-value"><%= number_with_delimiter(row[:xanax_gained]) %></span>
                  <span class="stat-daily <%= compliance_class(row[:xanax_daily], @faction.xanax_target) %>">
                    <%= row[:xanax_daily] %>/day
                  </span>
                </div>
              </td>
              <td>
                <div class="stat-cell">
                  <span class="stat-value"><%= number_with_delimiter(row[:energy_refills_gained]) %></span>
                  <span class="stat-daily <%= compliance_class(row[:energy_refills_daily], @faction.energy_refill_target) %>">
                    <%= row[:energy_refills_daily] %>/day
                  </span>
                </div>
              </td>
              <td>
                <div class="stat-cell">
                  <span class="stat-value"><%= number_with_delimiter(row[:nerve_refills_gained]) %></span>
                  <span class="stat-daily <%= compliance_class(row[:nerve_refills_daily], @faction.nerve_refill_target) %>">
                    <%= row[:nerve_refills_daily] %>/day
                  </span>
                </div>
              </td>
              <td>
                <div class="stat-cell">
                  <span class="stat-value"><%= number_with_delimiter(row[:missions_gained]) %></span>
                  <span class="stat-daily"><%= row[:missions_daily] %>/day</span>
                </div>
              </td>
              <td>
                <div class="stat-cell">
                  <span class="stat-value"><%= number_with_delimiter(row[:crimes_gained]) %></span>
                  <span class="stat-daily"><%= row[:crimes_daily] %>/day</span>
                </div>
              </td>
              <td>
                <div class="stat-cell">
                  <span class="stat-value"><%= number_with_delimiter(row[:activity_time_gained]) %> min</span>
                  <span class="stat-daily"><%= row[:activity_time_daily] %> min/day</span>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
<% end %>
