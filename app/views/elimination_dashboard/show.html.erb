<div class="cia-dashboard">
  <div class="cia-dashboard-header">
    <%= image_tag "cia-logo.png", alt: "Conspiracy Intelligence Agency", class: "cia-logo-small" %>
    <div>
      <h1>Conspiracy Intelligence Agency</h1>
      <p class="cia-subtitle">Bot admin panel</p>
    </div>
    <%= button_to "Log out", elimination_dashboard_logout_path, method: :delete, class: "btn-secondary cia-logout" %>
  </div>

  <%= render "status_panels",
    setting: @setting,
    bot_token_present: @bot_token_present,
    start_path: elimination_dashboard_start_path,
    stop_path: elimination_dashboard_stop_path %>

  <div class="admin-stats-panel" style="margin-bottom: var(--space-3, 12px);">
    <h2>Settings</h2>
    <%= form_with model: @setting, url: elimination_dashboard_settings_path, method: :patch do |form| %>
      <div class="cia-settings-grid">
        <div class="form-group">
          <%= form.label :alerts_channel_id, "Alerts channel ID", class: "form-label" %>
          <%= form.text_field :alerts_channel_id, class: "form-input", placeholder: "Right-click channel → Copy Channel ID" %>
          <p class="form-help">Every bot message goes to this channel</p>
        </div>
        <div class="form-group">
          <%= form.label :push_ticket_threshold, "Push threshold (tickets)", class: "form-label" %>
          <%= form.number_field :push_ticket_threshold, min: 1, class: "form-input" %>
          <p class="form-help">Tickets lost inside the window = push</p>
        </div>
        <div class="form-group">
          <%= form.label :push_window_seconds, "Push window (seconds)", class: "form-label" %>
          <%= form.number_field :push_window_seconds, min: 2, class: "form-input" %>
        </div>
        <div class="form-group">
          <%= form.label :push_resolve_seconds, "Push over after (seconds quiet)", class: "form-label" %>
          <%= form.number_field :push_resolve_seconds, min: 30, class: "form-input" %>
          <p class="form-help">900 = 15 minutes; waves inside this window count as one push</p>
        </div>
        <div class="form-group">
          <%= form.label :standings_interval_minutes, "Standings every (minutes)", class: "form-label" %>
          <%= form.number_field :standings_interval_minutes, min: 5, class: "form-input" %>
        </div>
      </div>
      <%= form.submit "Save settings", class: "btn-primary cia-btn-sm" %>
    <% end %>
  </div>

  <div class="admin-stats-panel" style="margin-bottom: var(--space-3, 12px);">
    <h2>How push alerts work</h2>
    <ul class="cia-explainer">
      <li>The bot checks all ticket scores every <%= @setting.poll_interval_seconds %> seconds.</li>
      <li>A push means: our team loses <%= @setting.push_ticket_threshold %> or more tickets within <%= @setting.push_window_seconds %> seconds. Other teams getting pushed does not trigger a message.</li>
      <li>When a push starts, the bot posts <b>one message</b>.</li>
      <li>While the push goes on, the bot does not post again. It updates that same message with fresh numbers. A push can last for hours and it stays one single message, so there is no spam.</li>
      <li>The push is over when we lose no big amount of tickets for <%= @setting.push_resolve_seconds / 60 %> minutes. The bot then turns the message green: "push over".</li>
      <li>If the attackers stop and come back later than that, it counts as a new push and gets a new message.</li>
      <li>Discord only sends a notification for the first message. The updates are silent.</li>
    </ul>
  </div>

  <div class="admin-stats-panel">
    <h2>Notifications <span class="admin-stats-hint">Test sends mock data. Live sends real current data. Both work even when a notification is off.</span></h2>
    <% EliminationSetting::NOTIFICATIONS.each do |notification| %>
      <% enabled = @setting.public_send("notify_#{notification[:key]}?") %>
      <div class="cia-notify-row">
        <span class="cia-notify-label"><%= notification[:label] %></span>
        <%= button_to enabled ? "On" : "Off",
          elimination_dashboard_toggle_path(key: notification[:key]),
          method: :post, class: "cia-toggle #{enabled ? "is-on" : "is-off"}" %>
        <div class="cia-notify-tests">
          <% notification[:demos].each do |demo| %>
            <%= button_to "Test #{demo.humanize.downcase.delete_prefix("push ").delete_prefix("tick ").delete_prefix("health ")}",
              elimination_dashboard_test_path(kind: demo),
              method: :post, class: "btn-secondary cia-btn-sm" %>
          <% end %>
        </div>
        <div class="cia-notify-live">
          <% if notification[:live] %>
            <%= button_to "Live",
              elimination_dashboard_trigger_path(kind: notification[:key]),
              method: :post, class: "btn-primary cia-btn-sm" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
