<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Tornmanager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tornmanager">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="<%= asset_path('ns_favi.ico') %>" type="image/x-icon">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "layouts/header" %>
    <main>
      <%= yield %>
    </main>
    <%= render "layouts/footer" %>
    
    <div id="flash-notifications" class="flash-notifications" data-controller="flash-notifications">
      <% flash.each do |type, message| %>
        <%= render "layouts/flash", type: type, message: message %>
      <% end %>
    </div>
  </body>
</html>
