<nav data-controller="navbar" data-navbar-admin-value="<%= Current.user&.admin? ? 'true' : 'false' %>">
  <% if authenticated? %>
    <div class="navbar-left">
      <%= link_to "TornManager", Current.user&.faction&.track_stats ? faction_path(Current.user.faction) : stocks_path, class: "navbar-link navbar-title" %>
    </div>
    
    <div class="navbar-center">
      <% if Current.user&.faction&.track_stats %>
        <div class="navbar-faction-dropdown" data-controller="dropdown">
          <button class="navbar-link navbar-link-button #{'navbar-link-active' if request.path.start_with?('/factions')}" data-action="click->dropdown#toggle">
            My Faction
            <svg class="navbar-user-arrow" data-dropdown-target="arrow" width="10" height="10" viewBox="0 0 12 12" fill="none">
              <path d="M3 5L6 8L9 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="navbar-dropdown navbar-dropdown-left" data-dropdown-target="menu">
            <%= link_to "Dashboard", faction_path(Current.user.faction), class: "navbar-dropdown-item" %>
            <%= link_to "Training", faction_training_path(Current.user.faction), class: "navbar-dropdown-item" %>
            <%= link_to "Ranked Wars", faction_ranked_wars_path(Current.user.faction), class: "navbar-dropdown-item" %>
            <%= link_to "Spy Stats", faction_spy_stats_path(Current.user.faction), class: "navbar-dropdown-item" %>
            <%= link_to "Settings", faction_settings_path(Current.user.faction), class: "navbar-dropdown-item" %>
          </div>
        </div>
      <% else %>
        <span class="navbar-link navbar-link-disabled" title="Join a tracked faction to access">My Faction</span>
      <% end %>
      <%= link_to "Hall of Famers", hall_of_famers_path, class: "navbar-link #{'navbar-link-active' if request.path.start_with?('/hall-of-famers')}" %>
      <% if Current.user&.admin? %>
        <%= link_to "Admin", admin_dashboard_path, class: "navbar-link #{'navbar-link-active' if request.path.start_with?('/admin')}" %>
      <% end %>
    </div>
    
    <div class="navbar-right">
      <div class="navbar-user" data-controller="dropdown">
        <% if Current.user.profile_image.present? %>
          <img src="<%= Current.user.profile_image %>" alt="<%= Current.user.name %>" class="navbar-user-avatar" />
        <% end %>
        <button class="navbar-user-button" data-action="click->dropdown#toggle">
          <span class="navbar-user-name"><%= Current.user.name %></span>
          <svg class="navbar-user-arrow" data-dropdown-target="arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 5L6 8L9 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="navbar-dropdown" data-dropdown-target="menu">
          <%= link_to "Roadmap", roadmap_path, class: "navbar-dropdown-item" %>
          <%= link_to "API Calls", user_api_calls_path, class: "navbar-dropdown-item" %>
          <%= link_to "Stocks", stocks_path, class: "navbar-dropdown-item" %>
          <%= link_to "Settings", settings_path, class: "navbar-dropdown-item" %>
          <%= button_to "Sign Out", session_path, method: :delete, class: "navbar-dropdown-item navbar-dropdown-signout" %>
        </div>
      </div>
    </div>
    
    <!-- Mobile menu -->
    <div class="navbar-mobile" data-controller="dropdown">
      <% if Current.user.profile_image.present? %>
        <img src="<%= Current.user.profile_image %>" alt="<%= Current.user.name %>" class="navbar-user-avatar" />
      <% end %>
      <button class="navbar-mobile-toggle" data-action="click->dropdown#toggle" aria-label="Toggle menu">
        <svg class="navbar-hamburger-icon" data-dropdown-target="arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <div class="navbar-mobile-menu" data-dropdown-target="menu">
        <div class="navbar-mobile-menu-section">
          <% if Current.user&.faction&.track_stats %>
            <span class="navbar-mobile-menu-label">My Faction</span>
            <%= link_to "Dashboard", faction_path(Current.user.faction), class: "navbar-mobile-menu-item navbar-mobile-menu-item-nested #{'active' if request.path == faction_path(Current.user.faction)}" %>
            <%= link_to "Training", faction_training_path(Current.user.faction), class: "navbar-mobile-menu-item navbar-mobile-menu-item-nested #{'active' if request.path.include?('/training')}" %>
            <%= link_to "Ranked Wars", faction_ranked_wars_path(Current.user.faction), class: "navbar-mobile-menu-item navbar-mobile-menu-item-nested" %>
            <%= link_to "Spy Stats", faction_spy_stats_path(Current.user.faction), class: "navbar-mobile-menu-item navbar-mobile-menu-item-nested" %>
            <%= link_to "Settings", faction_settings_path(Current.user.faction), class: "navbar-mobile-menu-item navbar-mobile-menu-item-nested" %>
          <% else %>
            <span class="navbar-mobile-menu-item disabled">My Faction</span>
          <% end %>
          <%= link_to "Hall of Famers", hall_of_famers_path, class: "navbar-mobile-menu-item #{'active' if request.path.start_with?('/hall-of-famers')}" %>
          <% if Current.user&.admin? %>
            <%= link_to "Admin", admin_dashboard_path, class: "navbar-mobile-menu-item #{'active' if request.path.start_with?('/admin')}" %>
          <% end %>
        </div>
        <div class="navbar-mobile-menu-divider"></div>
        <div class="navbar-mobile-menu-section">
          <%= link_to "Roadmap", roadmap_path, class: "navbar-mobile-menu-item" %>
          <%= link_to "API Calls", user_api_calls_path, class: "navbar-mobile-menu-item" %>
          <%= link_to "Stocks", stocks_path, class: "navbar-mobile-menu-item" %>
          <%= link_to "Settings", settings_path, class: "navbar-mobile-menu-item" %>
          <%= button_to "Sign Out", session_path, method: :delete, class: "navbar-mobile-menu-item signout" %>
        </div>
      </div>
    </div>
    
    <div class="live-api-feed" id="live-api-feed" data-turbo-permanent data-controller="api-live-feed">
      <div class="live-api-feed-list" data-api-live-feed-target="list"></div>
    </div>
  <% else %>
    <div class="navbar-left">
      <%= link_to "TornManager", root_path, class: "navbar-link navbar-title" %>
    </div>
    <div class="navbar-center">
      <%= link_to "Key Activity Log", key_log_path, class: "navbar-link #{'navbar-link-active' if request.path.start_with?('/key-log')}" %>
      <%= link_to "Roadmap", roadmap_path, class: "navbar-link #{'navbar-link-active' if request.path.start_with?('/roadmap')}" %>
    </div>
    <div class="navbar-right">
      <%= link_to "Sign In", new_session_path, class: "navbar-signin" %>
    </div>
    
    <!-- Mobile menu (unauthenticated) -->
    <div class="navbar-mobile" data-controller="dropdown">
      <button class="navbar-mobile-toggle" data-action="click->dropdown#toggle" aria-label="Toggle menu">
        <svg class="navbar-hamburger-icon" data-dropdown-target="arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <div class="navbar-mobile-menu" data-dropdown-target="menu">
        <div class="navbar-mobile-menu-section">
          <%= link_to "Key Activity Log", key_log_path, class: "navbar-mobile-menu-item #{'active' if request.path.start_with?('/key-log')}" %>
          <%= link_to "Roadmap", roadmap_path, class: "navbar-mobile-menu-item #{'active' if request.path.start_with?('/roadmap')}" %>
          <%= link_to "Sign In", new_session_path, class: "navbar-mobile-menu-item" %>
        </div>
      </div>
    </div>
  <% end %>
</nav>
