<nav data-controller="navbar">
  <% if authenticated? %>
    <div class="navbar-left">
      <%= link_to "TornManager", progress_index_path, class: "navbar-link navbar-title" %>
    </div>
    <div class="navbar-center">
      <%= link_to "[p] My Progress", progress_index_path, class: "navbar-link #{'navbar-link-active' if request.path.start_with?('/progress')}" %>
      <span class="navbar-link navbar-link-disabled">[f] My Faction (Coming Soon)</span>
      <%= link_to "[h] Hall of Famers", hall_of_famers_path, class: "navbar-link #{'navbar-link-active' if request.path.start_with?('/hall-of-famers')}" %>
      <% if Current.user&.admin? %>
        <%= link_to "[a] Admin", subscriptions_path, class: "navbar-link #{'navbar-link-active' if request.path.start_with?('/subscriptions')}" %>
      <% end %>
    </div>
    <div class="navbar-right">
      <div class="navbar-user" data-controller="dropdown">
        <% if Current.user.profile_image.present? %>
          <img src="<%= Current.user.profile_image %>" alt="<%= Current.user.name %>" class="navbar-user-avatar" />
        <% end %>
        <button class="navbar-user-button" data-action="click->dropdown#toggle">
          <span class="navbar-user-name"><%= Current.user.name %></span>
          <svg class="navbar-user-arrow" data-dropdown-target="arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 5L6 8L9 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="navbar-dropdown" data-dropdown-target="menu">
          <%= link_to "API Calls", user_api_calls_path, class: "navbar-dropdown-item" %>
          <span class="navbar-dropdown-item navbar-dropdown-disabled">Settings (Coming Soon)</span>
          <%= button_to "Sign Out", session_path, method: :delete, class: "navbar-dropdown-item navbar-dropdown-signout" %>
        </div>
      </div>
    </div>
    <div class="live-api-feed" id="live-api-feed" data-turbo-permanent data-controller="api-live-feed">
      <div class="live-api-feed-list" data-api-live-feed-target="list"></div>
    </div>
  <% else %>
    <div class="navbar-left">
      <%= link_to "TornManager", root_path, class: "navbar-link navbar-title" %>
    </div>
    <div class="navbar-center">
      <%= link_to "Key Activity Log", key_log_path, class: "navbar-link #{'navbar-link-active' if request.path.start_with?('/key-log')}" %>
    </div>
    <div class="navbar-right">
      <%= link_to "Sign In", new_session_path, class: "navbar-signin" %>
    </div>
  <% end %>
</nav>
