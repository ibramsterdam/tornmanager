<div class="key-log-container">
  <div class="key-log-header">
    <h1>API Key Activity Log</h1>
    <p class="key-log-subtitle">View what requests have been made with your API key</p>
  </div>

  <% if flash[:alert] %>
    <div role="alert" class="flash flash-alert"><%= flash[:alert] %></div>
  <% end %>

  <%= form_with url: key_log_show_path, method: :post, class: "key-log-form-centered", data: { controller: "keylog", turbo: false } do |form| %>
    <div class="form-group">
      <%= form.label :api_key, "Your API Key", class: "form-label" %>
      <%= form.text_field :api_key, 
          class: "form-input", 
          placeholder: "Enter your Torn API key", 
          autocomplete: "off",
          data: { 
            keylog_target: "input",
            action: "input->keylog#checkInput"
          } %>
    </div>

    <div class="key-log-confirmations">
      <div class="key-log-checkbox-field">
        <input 
          type="checkbox" 
          id="privacy_checkbox" 
          class="key-log-checkbox"
          data-keylog-target="checkbox"
          data-action="change->keylog#checkInput" />
        <label for="privacy_checkbox" class="key-log-checkbox-label">
          I understand this will make <strong>3 API calls</strong> to fetch the last 300 log entries (comment: "tmanager")
        </label>
      </div>

      <div class="key-log-checkbox-field">
        <input 
          type="checkbox" 
          id="storage_checkbox" 
          class="key-log-checkbox"
          data-keylog-target="checkbox"
          data-action="change->keylog#checkInput" />
        <label for="storage_checkbox" class="key-log-checkbox-label">
          I understand my API key is <strong>not stored</strong> and data is fetched directly from Torn's servers
        </label>
      </div>
    </div>
    
    <%= form.submit "View Activity Log", 
        class: "btn btn-primary btn-large",
        data: { keylog_target: "submit" },
        disabled: true %>
  <% end %>

  <div class="key-log-info">
    <h3>What you'll see:</h3>
    <ul>
      <li><strong>Peak Usage:</strong> Maximum requests per minute (rate limit is 100/min)</li>
      <li><strong>Request Breakdown:</strong> Types, selections, tools, and IP addresses</li>
      <li><strong>Detailed Log:</strong> Last 300 API requests with timestamps</li>
      <li><strong>Rate Limit Warnings:</strong> Alerts if you're approaching or exceeding limits</li>
    </ul>
  </div>
</div>
