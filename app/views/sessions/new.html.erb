<section class="login-container" aria-label="Sign in" data-controller="login">
  <%= form_with url: session_path, html: { class: "login-form" } do |form| %>
    <div class="login-header">
      <h1 class="login-title">Sign In</h1>
    </div>
    
    <% if flash[:alert] %>
      <div role="alert" class="flash flash-alert"><%= flash[:alert] %></div>
    <% end %>
    
    <div class="login-field">
      <label for="api_key" class="login-label">API Key</label>
      <%= form.text_field :api_key,
          id: "api_key",
          required: true,
          autofocus: true,
          autocomplete: "username",
          placeholder: "Enter your Torn API key",
          value: params[:api_key],
          class: "login-input" %>
      <p class="login-hint">Requires a Limited Access key, <%= link_to "create one here", "https://www.torn.com/preferences.php#tab=api?&step=addNewKey&title=TornManager&type=3", target: "_blank" %></p>
    </div>
    
    <div class="login-checkbox-field">
      <input 
        type="checkbox" 
        id="terms_checkbox" 
        class="login-checkbox"
        data-login-target="checkbox"
        data-action="change->login#toggle" />
      <label for="terms_checkbox" class="login-checkbox-label">
        I agree to the <%= link_to "Privacy Policy", privacy_policy_path, class: "login-checkbox-link", target: "_blank" %> and <%= link_to "Terms of Service", terms_of_service_path, class: "login-checkbox-link", target: "_blank" %>
      </label>
    </div>
    
    <button 
      type="submit" 
      class="login-submit"
      data-login-target="submit"
      disabled>Sign In</button>
  <% end %>
</section>
