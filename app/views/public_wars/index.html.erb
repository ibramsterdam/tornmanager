<h1 class="public-wars-title">Public Ranked Wars</h1>

<div class="public-wars-layout" data-controller="lobby-unlock" data-lobby-unlock-csrf-value="<%= form_authenticity_token %>">
  <div class="public-wars-create-card">
    <div class="public-wars-create-info">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      <p>
        <strong>Your API key is never stored in my database.</strong>
        Held in memory only for polling. Lost on termination or server restart.
      </p>
    </div>

    <%= render "shared/api_tos_table",
        data_storage: "Not stored - held in memory only during polling",
        key_storage: "Never stored / Not shared",
        key_access_level: "Public Only" %>

    <%= form_with url: public_wars_path, method: :post, class: "public-wars-create-form" do %>
      <div class="public-wars-create-row">
        <div class="public-wars-create-field">
          <label class="public-wars-create-label">API Key</label>
          <input type="text" name="api_key" class="setup-input" placeholder="Public Only key" autocomplete="off" required value="<%= params[:api_key] %>">
        </div>
        <div class="public-wars-create-field">
          <label class="public-wars-create-label">Faction ID</label>
          <input type="number" name="faction_torn_id" class="setup-input" placeholder="e.g. 9055" required value="<%= params[:faction_torn_id] %>">
        </div>
      </div>

      <div class="public-wars-create-field">
        <label class="public-wars-create-label">Password <span class="public-wars-optional">optional</span></label>
        <input type="password" name="password" class="setup-input" placeholder="Leave blank for open access" autocomplete="new-password">
      </div>

      <label class="public-wars-tos-label">
        <input type="checkbox" name="accept_terms" value="1" required>
        <span>I accept the <%= link_to "TOS", legal_path(anchor: "terms-of-service"), target: "_blank" %> and <%= link_to "Privacy Policy", legal_path(anchor: "privacy-policy"), target: "_blank" %></span>
      </label>

      <button type="submit" class="btn btn-primary">Create Lobby</button>

      <p class="public-wars-api-note">
        Only <strong>Public Only</strong> keys accepted. ~20 API calls/min.
      </p>
    <% end %>
  </div>

  <% remaining_slots = PublicWarLobby::MAX_LOBBIES - @lobbies.size %>

  <% @lobbies.each do |lobby| %>
    <% locked = lobby.password_protected? && !lobby_unlocked?(lobby) %>
    <% if locked %>
      <div class="public-war-card public-war-card--locked"
           role="button" tabindex="0"
           data-action="click->lobby-unlock#open keydown.enter->lobby-unlock#open"
           data-lobby-unlock-url-param="<%= unlock_public_war_path(lobby) %>">
        <%= render "public_wars/lobby_card_content", lobby: lobby %>
      </div>
    <% else %>
      <%= link_to public_war_path(lobby), class: "public-war-card" do %>
        <%= render "public_wars/lobby_card_content", lobby: lobby %>
      <% end %>
    <% end %>
  <% end %>

  <% remaining_slots.times do %>
    <div class="public-war-card-empty">
      <span class="public-war-empty-label">Available</span>
    </div>
  <% end %>

  <div class="public-war-modal-backdrop" data-lobby-unlock-target="backdrop" data-action="click->lobby-unlock#backdropClose" hidden>
    <div class="public-war-modal" data-lobby-unlock-target="modal">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <h3>Password Required</h3>
      <p class="public-war-modal-error" data-lobby-unlock-target="error" hidden></p>
      <form data-action="submit->lobby-unlock#submit">
        <div class="public-war-modal-input">
          <input type="password" data-lobby-unlock-target="password" class="setup-input" placeholder="Enter lobby password" autocomplete="off">
          <button type="submit" class="btn btn-primary" data-lobby-unlock-target="submitButton">Unlock</button>
        </div>
      </form>
    </div>
  </div>
</div>
