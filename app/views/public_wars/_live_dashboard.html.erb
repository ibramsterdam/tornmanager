<div class="live-war-dashboard"
     data-controller="war-dashboard"
     data-war-dashboard-initial-data-value="<%= (war_data || {}).to_json %>"
     data-war-dashboard-our-score-value="0"
     data-war-dashboard-their-score-value="0"
     data-war-dashboard-target-score-value="0"
     data-war-dashboard-faction-name-value="<%= lobby.faction_name %>"
     data-war-dashboard-enemy-name-value="<%= lobby.opponent_faction_name %>"
     data-war-dashboard-started-at-value=""
     data-war-dashboard-scheduled-value="false"
     data-war-dashboard-poll-url-value="<%= war_data_public_war_path(lobby) %>"
     data-war-dashboard-poll-interval-value="3000"
     data-war-dashboard-hide-stats-value="false"
     data-war-dashboard-editable-stats-value="true"
     data-war-dashboard-stats-url-value="<%= stats_public_war_path(lobby) %>"
     data-war-dashboard-terminated-url-value="<%= public_wars_path(terminated: 1) %>">

  <div class="live-war-scores-minimal">
    <div class="live-war-score-side our-side">
      <span class="live-score-label"><%= link_to lobby.faction_name, "https://www.torn.com/factions.php?step=profile&ID=#{lobby.faction_torn_id}", target: "_blank", class: "faction-link" %></span>
    </div>

    <div class="live-war-score-center">
      <div class="live-war-status-badge">
        <% if lobby.active? %>
          <span class="war-status-dot live"></span>
          <span>Live</span>
        <% else %>
          <span class="war-status-dot"></span>
          <span>Inactive</span>
        <% end %>
      </div>
    </div>

    <div class="live-war-score-side their-side">
      <span class="live-score-label"><%= lobby.opponent_faction_name %></span>
    </div>
  </div>

  <div class="live-war-table-card">
    <div class="live-war-table-header">
      <div class="live-war-table-title">
        <span class="table-title-text">Enemy Members</span>
        <span class="table-title-count">(<span data-war-dashboard-target="visibleCount">0</span>/<span data-war-dashboard-target="totalCount">0</span>)</span>
        <span class="table-title-filter-count" data-war-dashboard-target="filterCount"></span>
      </div>
      <div class="live-war-table-status">
        <span class="live-war-updated" data-war-dashboard-target="lastUpdated"></span>
        <span class="live-war-countdown" data-war-dashboard-target="updateCountdown"></span>
        <span class="live-polling-status" data-war-dashboard-target="connectionStatus">
          <span class="live-polling-dot"></span>
          <span class="live-polling-text">Live</span>
        </span>
      </div>
    </div>

    <div class="live-war-filters">
      <div class="war-filter-group">
        <span class="war-filter-label">Status</span>
        <div class="war-filter-options">
          <span class="member-status status-okay war-filter-toggle" data-action="click->war-dashboard#toggleFilter" data-war-dashboard-target="filterStatusOkay" data-filter-active="true">Okay</span>
          <span class="member-status status-hospital war-filter-toggle" data-action="click->war-dashboard#toggleFilter" data-war-dashboard-target="filterStatusHospital" data-filter-active="true">Hospital</span>
          <span class="member-status status-jail war-filter-toggle" data-action="click->war-dashboard#toggleFilter" data-war-dashboard-target="filterStatusJail" data-filter-active="true">Jail</span>
          <span class="member-status status-traveling war-filter-toggle" data-action="click->war-dashboard#toggleFilter" data-war-dashboard-target="filterStatusTraveling" data-filter-active="true">Traveling</span>
          <span class="member-status status-abroad war-filter-toggle" data-action="click->war-dashboard#toggleFilter" data-war-dashboard-target="filterStatusAbroad" data-filter-active="true">Abroad</span>
        </div>
      </div>
      <div class="war-filter-group">
        <span class="war-filter-label">Activity</span>
        <div class="war-filter-options">
          <span class="action-badge action-online war-filter-toggle" data-action="click->war-dashboard#toggleFilter" data-war-dashboard-target="filterActionOnline" data-filter-active="true">Online</span>
          <span class="action-badge action-idle war-filter-toggle" data-action="click->war-dashboard#toggleFilter" data-war-dashboard-target="filterActionIdle" data-filter-active="true">Idle</span>
          <span class="action-badge action-offline war-filter-toggle" data-action="click->war-dashboard#toggleFilter" data-war-dashboard-target="filterActionOffline" data-filter-active="true">Offline</span>
        </div>
      </div>
      <div class="war-filter-group war-filter-stats">
        <span class="war-filter-label">Max Stats</span>
        <div class="war-filter-slider">
          <input type="range" min="0" max="50000000000" step="100000000" value="50000000000"
                 data-action="input->war-dashboard#applyFilters"
                 data-war-dashboard-target="filterMaxStats">
          <span class="war-filter-slider-value" data-war-dashboard-target="filterMaxStatsLabel">No limit</span>
        </div>
      </div>
    </div>

    <div class="live-war-table-scroll">
      <table>
        <thead>
          <tr>
            <th class="sortable" data-action="click->war-dashboard#sort" data-war-dashboard-sort-key-param="name">
              Member <span class="sort-indicator" data-war-dashboard-target="sortIndicatorName"></span>
            </th>
            <th class="sortable" data-action="click->war-dashboard#sort" data-war-dashboard-sort-key-param="level">
              Lvl <span class="sort-indicator" data-war-dashboard-target="sortIndicatorLevel"></span>
            </th>
            <th class="sortable" data-action="click->war-dashboard#sort" data-war-dashboard-sort-key-param="status">
              Status <span class="sort-indicator" data-war-dashboard-target="sortIndicatorStatus"></span>
            </th>
            <th class="sortable" data-action="click->war-dashboard#sort" data-war-dashboard-sort-key-param="lastAction">
              Activity <span class="sort-indicator" data-war-dashboard-target="sortIndicatorLastAction"></span>
            </th>
            <th class="sortable" data-action="click->war-dashboard#sort" data-war-dashboard-sort-key-param="timer">
              Timer
              <span class="column-help" tabindex="0">
                <span class="column-help-icon">?</span>
                <span class="column-help-tooltip">
                  <strong>Hospital/Jail</strong>: countdown until release.<br>
                  <strong>Travel</strong>: estimated arrival based on plane type and destination.<br>
                  <strong>Dual times</strong> (e.g. 4:20 / 12:34): airliner could be BCT (fast) or Standard (slow).<br>
                  <strong>Destination only</strong> (no timer): traveler was mid-flight when tracking started.
                </span>
              </span>
              <span class="sort-indicator" data-war-dashboard-target="sortIndicatorTimer"></span>
            </th>
            <th class="sortable" data-action="click->war-dashboard#sort" data-war-dashboard-sort-key-param="total">
              Total Stats <span class="sort-indicator" data-war-dashboard-target="sortIndicatorTotal"></span>
            </th>
            <th class="sortable" data-action="click->war-dashboard#sort" data-war-dashboard-sort-key-param="strength">
              STR <span class="sort-indicator" data-war-dashboard-target="sortIndicatorStrength"></span>
            </th>
            <th class="sortable" data-action="click->war-dashboard#sort" data-war-dashboard-sort-key-param="defense">
              DEF <span class="sort-indicator" data-war-dashboard-target="sortIndicatorDefense"></span>
            </th>
            <th class="sortable" data-action="click->war-dashboard#sort" data-war-dashboard-sort-key-param="speed">
              SPD <span class="sort-indicator" data-war-dashboard-target="sortIndicatorSpeed"></span>
            </th>
            <th class="sortable" data-action="click->war-dashboard#sort" data-war-dashboard-sort-key-param="dexterity">
              DEX <span class="sort-indicator" data-war-dashboard-target="sortIndicatorDexterity"></span>
            </th>
            <th>
              Actions
            </th>
          </tr>
        </thead>
        <tbody data-war-dashboard-target="membersBody">
          <tr>
            <td colspan="11" class="table-empty-text">Loading enemy members...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
