<div class="form-container">
  <%= form_with url: create_faction_grant_subscriptions_path, method: :post do |form| %>
    <div class="form-group">
      <%= form.label :faction_id, "Faction ID" %>
      <%= form.number_field :faction_id, required: true, min: 1, class: "form-input" %>
      <p class="form-help">Enter the Torn faction ID</p>
    </div>
    
    <div class="form-group">
      <%= form.label :weeks, "Weeks to Grant" %>
      <%= form.number_field :weeks, required: true, min: 1, value: 1, class: "form-input" %>
      <p class="form-help">Number of weeks to extend subscriptions for all faction members</p>
    </div>
    
    <div class="form-actions">
      <%= form.submit "Grant Subscriptions", class: "button button-primary" %>
    </div>
  <% end %>
</div>
