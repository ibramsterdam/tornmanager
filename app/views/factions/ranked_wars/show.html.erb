<div class="war-detail-page">
  <!-- War Overview -->
  <div class="war-overview">
    <div class="war-overview-main">
      <div class="war-faction our-faction">
        <span class="faction-label">Your Faction</span>
        <span class="faction-name"><%= @faction.name %></span>
        <span class="faction-score <%= @war.won? ? 'winning' : 'losing' %>"><%= @war.our_score %></span>
      </div>

      <div class="war-vs">
        <div class="target-score">Target: <%= @war.target_score %></div>
        <% if @war.completed? %>
          <span class="war-status <%= @war.won? ? 'won' : 'lost' %>" style="font-size: 0.875rem;">
            <%= @war.won? ? "VICTORY" : "DEFEAT" %>
          </span>
        <% elsif @war.in_progress? %>
          <span class="war-status ongoing" style="font-size: 0.875rem;">LIVE</span>
        <% else %>
          <span class="war-status scheduled" style="font-size: 0.875rem;">SCHEDULED</span>
        <% end %>
        <div class="war-duration"><%= @war.duration_formatted %></div>
      </div>

      <div class="war-faction their-faction">
        <span class="faction-label">Opponent</span>
        <span class="faction-name"><%= link_to @war.opponent_faction_name, "https://www.torn.com/factions.php?step=profile&ID=#{@war.opponent_faction_id}", target: "_blank", class: "faction-link" %></span>
        <span class="faction-score <%= @war.lost? ? 'winning' : 'losing' %>"><%= @war.their_score %></span>
      </div>
    </div>

    <% if @war.respect_gained.to_i > 0 || @war.points_gained.to_i > 0 %>
      <div class="war-rewards-inline">
        <% if @war.respect_gained.to_i > 0 %>
          <div class="reward-badge">
            <span class="reward-value">+<%= number_with_delimiter(@war.respect_gained) %></span>
            <span class="reward-label">respect</span>
          </div>
        <% end %>
        <% if @war.points_gained.to_i > 0 %>
          <div class="reward-badge">
            <span class="reward-value">+<%= @war.points_gained %></span>
            <span class="reward-label">points</span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Stats Comparison -->
  <div class="war-stats-comparison">
    <h2>Stats Comparison</h2>
    <div class="stats-comparison-table">
      <div class="stats-row stats-header">
        <span class="stats-cell ours"><%= @faction.name %></span>
        <span class="stats-cell label"></span>
        <span class="stats-cell theirs"><%= @war.opponent_faction_name %></span>
      </div>
      <div class="stats-row">
        <span class="stats-cell ours <%= @war.our_attacks > @war.their_attacks ? 'better' : '' %>"><%= number_with_delimiter(@war.our_attacks) %></span>
        <span class="stats-cell label">Attacks</span>
        <span class="stats-cell theirs <%= @war.their_attacks > @war.our_attacks ? 'better' : '' %>"><%= number_with_delimiter(@war.their_attacks) %></span>
      </div>
      <div class="stats-row">
        <span class="stats-cell ours <%= @war.score_per_attack >= @war.their_score_per_attack ? 'better' : '' %>"><%= @war.score_per_attack %></span>
        <span class="stats-cell label">Avg Respect/Hit</span>
        <span class="stats-cell theirs <%= @war.their_score_per_attack >= @war.score_per_attack ? 'better' : '' %>"><%= @war.their_score_per_attack %></span>
      </div>
      <% if @war.rank_before && @war.rank_after %>
        <div class="stats-row">
          <span class="stats-cell ours">
            <span class="rank-display">
              <span class="rank-value"><%= @war.rank_before %></span>
              <span class="rank-arrow <%= @war.won? ? 'rank-up' : 'rank-down' %>"><%= @war.rank_change %></span>
              <span class="rank-value"><%= @war.rank_after %></span>
            </span>
          </span>
          <span class="stats-cell label">Rank</span>
          <span class="stats-cell theirs"></span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Members Grid -->
  <div class="war-members-grid">
    <!-- Our Members -->
    <div class="table-container">
      <div class="table-info">
        <span class="info-label"><%= @faction.name %> (<%= @our_members.count { |m| m["attacks"].to_i > 0 } %> fighters)</span>
      </div>
      <div class="table-scroll-wrapper">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Member</th>
              <th>Attacks</th>
              <th>Score</th>
              <th>Respect/Hit</th>
            </tr>
          </thead>
          <tbody>
            <% @our_members.select { |m| m["attacks"].to_i > 0 }.each_with_index do |member, index| %>
              <tr>
                <td class="rank-position"><%= index + 1 %></td>
                <td>
                  <%= link_to member["name"], "https://www.torn.com/profiles.php?XID=#{member["id"]}", target: "_blank", class: "player-link" %>
                </td>
                <td><%= member["attacks"] %></td>
                <td class="score-highlight"><%= member["score"].to_f.round(1) %></td>
                <td>
                  <% attacks = member["attacks"].to_i %>
                  <% score = member["score"].to_f %>
                  <%= attacks > 0 ? (score / attacks).round(2) : "-" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @our_non_participants.any? %>
        <details class="non-participants">
          <summary><%= @our_non_participants.count %> non-participants</summary>
          <div class="non-participants-list">
            <% @our_non_participants.each do |member| %>
              <span class="non-participant">
                <%= link_to member["name"], "https://www.torn.com/profiles.php?XID=#{member["id"]}", target: "_blank", class: "player-link" %>
              </span>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>

    <!-- Their Members -->
    <div class="table-container">
      <div class="table-info">
        <span class="info-label"><%= @war.opponent_faction_name %> (<%= @their_members.count { |m| m["attacks"].to_i > 0 } %> fighters)</span>
      </div>
      <div class="table-scroll-wrapper">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Member</th>
              <th>Attacks</th>
              <th>Score</th>
              <th>Respect/Hit</th>
            </tr>
          </thead>
          <tbody>
            <% @their_members.select { |m| m["attacks"].to_i > 0 }.each_with_index do |member, index| %>
              <tr>
                <td class="rank-position"><%= index + 1 %></td>
                <td>
                  <%= link_to member["name"], "https://www.torn.com/profiles.php?XID=#{member["id"]}", target: "_blank", class: "player-link" %>
                </td>
                <td><%= member["attacks"] %></td>
                <td class="score-highlight"><%= member["score"].to_f.round(1) %></td>
                <td>
                  <% attacks = member["attacks"].to_i %>
                  <% score = member["score"].to_f %>
                  <%= attacks > 0 ? (score / attacks).round(2) : "-" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="war-detail-footer">
    <span class="muted">War started <%= @war.started_at.strftime("%B %d, %Y at %H:%M") %></span>
  </div>
</div>
