<% if @war.ongoing? %>
  <!-- Live/scheduled war: no page header, dashboard has its own header -->
<% else %>
  <div class="page-header">
    <div class="page-header-content">
      <div>
        <h1>
          <% if @war.scheduled? %>
            <span class="war-status scheduled">SOON</span>
          <% elsif @war.won? %>
            <span class="war-status won">WIN</span>
          <% else %>
            <span class="war-status lost">LOSS</span>
          <% end %>
          vs <%= link_to @war.opponent_faction_name, "https://www.torn.com/factions.php?step=profile&ID=#{@war.opponent_faction_id}", target: "_blank", class: "faction-link" %>
        </h1>
        <p class="page-subtitle"><%= @war.started_at.strftime("%d %B %Y at %H:%M") %></p>
      </div>
      <div class="page-header-actions">
        <%= link_to "Back to Wars", faction_ranked_wars_path(@faction), class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
<% end %>

<% if @war.ongoing? %>
  <%= render "factions/ranked_wars/live_dashboard",
             war: @war,
             faction: @faction,
             war_data: @war_data,
             polling_active: @polling_active %>
<% else %>
  <!-- War Overview -->
  <div class="war-overview">
    <div class="war-overview-main">
      <div class="war-faction our-faction">
        <span class="faction-label">Our Faction</span>
        <span class="faction-name"><%= link_to @faction.name, "https://www.torn.com/factions.php?step=profile&ID=#{@faction.torn_id}", target: "_blank", class: "faction-link" %></span>
        <span class="faction-score <%= @war.our_score >= @war.their_score ? 'winning' : 'losing' %>"><%= @war.our_score %></span>
      </div>
      
      <div class="war-vs">
        <div class="target-score">Target: <%= @war.target_score %></div>
        <div class="war-duration"><%= @war.duration_formatted %></div>
      </div>
      
      <div class="war-faction their-faction">
        <span class="faction-label">Opponent</span>
        <span class="faction-name"><%= link_to @war.opponent_faction_name, "https://www.torn.com/factions.php?step=profile&ID=#{@war.opponent_faction_id}", target: "_blank", class: "faction-link" %></span>
        <span class="faction-score <%= @war.their_score > @war.our_score ? 'winning' : 'losing' %>"><%= @war.their_score %></span>
      </div>
    </div>
  </div>

  <!-- War Stats Comparison -->
  <div class="war-stats-comparison">
    <div class="stats-comparison-table">
      <div class="stats-row stats-header">
        <div class="stats-cell ours">Us</div>
        <div class="stats-cell label"></div>
        <div class="stats-cell theirs">Them</div>
      </div>
      <div class="stats-row">
        <div class="stats-cell ours <%= @war.our_attacks >= @war.their_attacks ? 'better' : '' %>"><%= @war.our_attacks %></div>
        <div class="stats-cell label">Attacks</div>
        <div class="stats-cell theirs <%= @war.their_attacks > @war.our_attacks ? 'better' : '' %>"><%= @war.their_attacks %></div>
      </div>
      <div class="stats-row">
        <div class="stats-cell ours <%= @war.score_per_attack >= @war.their_score_per_attack ? 'better' : '' %>"><%= @war.score_per_attack %></div>
        <div class="stats-cell label">Avg Score/Hit</div>
        <div class="stats-cell theirs <%= @war.their_score_per_attack > @war.score_per_attack ? 'better' : '' %>"><%= @war.their_score_per_attack %></div>
      </div>
      <% if @war.rank_before && @war.rank_after %>
        <div class="stats-row">
          <div class="stats-cell ours full-width" colspan="3">
            <span class="rank-display">
              <span class="rank-value"><%= @war.rank_before %></span>
              <span class="rank-arrow <%= @war.won? ? 'rank-up' : 'rank-down' %>"><%= @war.rank_change %></span>
              <span class="rank-value"><%= @war.rank_after %></span>
            </span>
          </div>
          <div class="stats-cell label">Rank</div>
          <div class="stats-cell theirs"></div>
        </div>
      <% end %>
    </div>

    <% if (@war.respect_gained && @war.respect_gained > 0) || (@war.points_gained && @war.points_gained > 0) %>
      <div class="war-rewards-inline">
        <% if @war.respect_gained && @war.respect_gained > 0 %>
          <div class="reward-badge">
            <span class="reward-value">+<%= number_with_delimiter(@war.respect_gained) %></span>
            <span class="reward-label">respect</span>
          </div>
        <% end %>
        <% if @war.points_gained && @war.points_gained > 0 %>
          <div class="reward-badge">
            <span class="reward-value">+<%= @war.points_gained %></span>
            <span class="reward-label">points</span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Member Performance Tables -->
  <div class="war-members-grid">
    <!-- Our Team -->
    <div class="table-container">
      <div class="table-info">
        <span class="info-label">Our Team (<%= @war.our_participating_members.count %> participants)</span>
      </div>

      <% if @war.our_members.blank? %>
        <div class="table-empty">
          <p class="table-empty-text">No member data available. Sync war reports to see detailed stats.</p>
        </div>
      <% else %>
        <div class="table-scroll-wrapper">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Member</th>
                <th>Attacks</th>
                <th>Score</th>
                <th>Avg/Hit</th>
              </tr>
            </thead>
            <tbody>
              <% @war.our_top_performers(50).each_with_index do |member, index| %>
                <tr class="<%= member['attacks'].to_i == 0 ? 'row-inactive' : '' %>">
                  <td class="rank-position"><%= index + 1 %></td>
                  <td>
                    <%= link_to member["name"], "https://www.torn.com/profiles.php?XID=#{member['id']}", target: "_blank", class: "player-link" %>
                  </td>
                  <td><%= member["attacks"] || 0 %></td>
                  <td class="score-highlight"><%= (member["score"] || 0).round(0) %></td>
                  <td>
                    <% attacks = member["attacks"].to_i %>
                    <% score = member["score"].to_f %>
                    <%= attacks > 0 ? (score / attacks).round(2) : "-" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @war.our_non_participants.any? %>
          <div class="non-participants">
            <details>
              <summary>Non-participants (<%= @war.our_non_participants.count %>)</summary>
              <div class="non-participants-list">
                <% @war.our_non_participants.each do |member| %>
                  <span class="non-participant">
                    <%= link_to member["name"], "https://www.torn.com/profiles.php?XID=#{member['id']}", target: "_blank", class: "player-link muted" %>
                  </span>
                <% end %>
              </div>
            </details>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- Their Team -->
    <div class="table-container">
      <div class="table-info">
        <span class="info-label">Opponent Team (<%= @war.their_participating_members.count %> participants)</span>
      </div>

      <% if @war.their_members.blank? %>
        <div class="table-empty">
          <p class="table-empty-text">No opponent data available.</p>
        </div>
      <% else %>
        <div class="table-scroll-wrapper">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Member</th>
                <th>Attacks</th>
                <th>Score</th>
                <th>Avg/Hit</th>
              </tr>
            </thead>
            <tbody>
              <% @war.their_top_performers(50).each_with_index do |member, index| %>
                <tr class="<%= member['attacks'].to_i == 0 ? 'row-inactive' : '' %>">
                  <td class="rank-position"><%= index + 1 %></td>
                  <td>
                    <%= link_to member["name"], "https://www.torn.com/profiles.php?XID=#{member['id']}", target: "_blank", class: "player-link" %>
                  </td>
                  <td><%= member["attacks"] || 0 %></td>
                  <td class="score-highlight"><%= (member["score"] || 0).round(0) %></td>
                  <td>
                    <% attacks = member["attacks"].to_i %>
                    <% score = member["score"].to_f %>
                    <%= attacks > 0 ? (score / attacks).round(2) : "-" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Rewards Section -->
  <% if @war.our_rewards.present? || @war.their_rewards.present? %>
    <div class="war-rewards-section">
      <h2>War Rewards</h2>
      <div class="rewards-grid">
        <% if @war.our_rewards.present? %>
          <div class="rewards-card">
            <h3>Our Rewards</h3>
            <ul class="rewards-list">
              <% @war.our_rewards.each do |key, value| %>
                <% next if value.nil? || value == 0 %>
                <li>
                  <span class="reward-key"><%= key.to_s.humanize %></span>
                  <span class="reward-value"><%= value.is_a?(Numeric) ? number_with_delimiter(value) : value %></span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if @war.their_rewards.present? %>
          <div class="rewards-card">
            <h3>Their Rewards</h3>
            <ul class="rewards-list">
              <% @war.their_rewards.each do |key, value| %>
                <% next if value.nil? || value == 0 %>
                <li>
                  <span class="reward-key"><%= key.to_s.humanize %></span>
                  <span class="reward-value"><%= value.is_a?(Numeric) ? number_with_delimiter(value) : value %></span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
