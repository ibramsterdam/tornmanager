<% if @tracking_disabled %>
  <div class="centered-content">
    <div class="info-card">
      <h2>Stats Tracking Disabled</h2>
      <p>This faction (<strong><%= @faction.name %></strong>) does not have stats tracking enabled.</p>
      <p>Contact an administrator to enable stats tracking for your faction.</p>
    </div>
  </div>
<% else %>
  <div data-controller="skeleton-loader">
    <div class="page-header">
      <div class="page-header-content">
        <div>
          <h1>Ranked Wars</h1>
          <p class="page-subtitle"><%= @faction.name %></p>
        </div>
        <div class="page-header-actions">
          <%= link_to "Back to Faction", faction_path(@faction), class: "btn btn-secondary" %>
        </div>
      </div>
    </div>

    <!-- Ongoing War Banner -->
    <% if @ongoing_war %>
      <div class="ongoing-war-banner">
        <div class="ongoing-war-content">
          <div class="ongoing-war-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div class="ongoing-war-text">
            <strong>War in Progress vs <%= link_to @ongoing_war.opponent_faction_name, "https://www.torn.com/factions.php?step=profile&ID=#{@ongoing_war.opponent_faction_id}", target: "_blank", class: "faction-link" %></strong>
            <span>
              Score: <strong class="<%= @ongoing_war.our_score > @ongoing_war.their_score ? 'score-winning' : 'score-losing' %>"><%= @ongoing_war.our_score %></strong> 
              - 
              <strong class="<%= @ongoing_war.their_score > @ongoing_war.our_score ? 'score-winning' : 'score-losing' %>"><%= @ongoing_war.their_score %></strong>
              (Target: <%= @ongoing_war.target_score %>)
            </span>
          </div>
          <div class="ongoing-war-action">
            <%= link_to "View Details", faction_ranked_war_path(@faction, @ongoing_war), class: "btn btn-primary btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Summary Stats -->
    <div class="war-summary">
      <div class="stat-box">
        <span class="count"><span class="wins-count"><%= @wins %></span> / <span class="losses-count"><%= @losses %></span></span>
        <span class="label">Wins / Losses</span>
      </div>
    </div>

    <!-- War History Table -->
    <div data-skeleton-loader-target="content">
      <%= render "war_history_table", wars: @wars, faction: @faction %>
    </div>
    <div data-skeleton-loader-target="skeleton" style="display: none;">
      <%= render "war_history_skeleton" %>
    </div>

    <!-- Member Performance Section -->
    <div data-skeleton-loader-target="content">
      <%= render "member_performance_table", member_performance: @member_performance %>
    </div>
    <div data-skeleton-loader-target="skeleton" style="display: none;">
      <%= render "member_performance_skeleton" %>
    </div>
  </div>
<% end %>
