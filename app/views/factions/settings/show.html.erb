<div class="page-header">
  <h1><%= @faction.name %> Settings</h1>
  <p class="page-subtitle">Configure API keys and manage spy data imports</p>
</div>

<%= link_to "← Back to faction", faction_path(@faction), class: "back-link mb-4" %>

<!-- Section 1: Spy Configuration -->
<div class="settings-section">
  <h2>Spy Configuration</h2>

  <div class="spy-config-card">
    <div class="spy-config-keys">
      <!-- Torn API Key -->
      <div class="spy-config-key-field">
        <div class="api-key-field-header">
          <span class="api-key-field-label">Torn API Key</span>
          <% if @faction_setting.torn_api_access_type.present? %>
            <span class="api-key-access-badge api-key-access-limited"><%= @faction_setting.torn_api_access_type %></span>
          <% end %>
        </div>
        <div class="api-key-field-current">
          <span class="api-key-value"><%= @torn_api_key_masked || "Not set" %></span>
          <% if @faction_setting.torn_api_key? %>
            <%= button_to "Delete", delete_torn_key_faction_settings_path(@faction),
                method: :delete,
                class: "key-delete-btn",
                data: { turbo_confirm: "Delete the Torn API key?" } %>
          <% end %>
        </div>
      </div>

      <!-- TornStats API Key -->
      <div class="spy-config-key-field">
        <div class="api-key-field-header">
          <span class="api-key-field-label">TornStats API Key</span>
        </div>
        <div class="api-key-field-current">
          <span class="api-key-value"><%= @tornstats_api_key_masked || "Not set" %></span>
          <% if @faction_setting.tornstats_api_key? %>
            <%= button_to "Delete", delete_tornstats_key_faction_settings_path(@faction),
                method: :delete,
                class: "key-delete-btn",
                data: { turbo_confirm: "Delete the TornStats API key?" } %>
          <% end %>
        </div>
      </div>
    </div>

    <%= form_with model: @faction_setting, url: faction_settings_path(@faction), method: :patch do |form| %>
      <div class="spy-config-keys spy-config-keys-inputs">
        <div class="spy-config-key-field">
          <%= form.text_field :torn_api_key,
              class: "api-key-form-input api-key-form-input-full",
              placeholder: "Enter new Torn API key",
              autocomplete: "off",
              value: "" %>
          <p class="api-key-form-hint">Must be a Limited Access key. Validated on save.</p>
        </div>

        <div class="spy-config-key-field">
          <%= form.text_field :tornstats_api_key,
              class: "api-key-form-input api-key-form-input-full",
              placeholder: "Enter new TornStats API key",
              autocomplete: "off",
              value: "" %>
          <p class="api-key-form-hint">Get your key from <a href="https://www.tornstats.com/settings" target="_blank">tornstats.com/settings</a>.</p>
        </div>
      </div>

      <div class="api-keys-actions">
        <%= form.submit "Save Keys", class: "btn-primary" %>
      </div>
    <% end %>

    <details class="spy-config-details">
      <summary>How your API keys are used<span class="ping-dot"><span class="ping-ring"></span></span></summary>
      <div class="spy-config-details-content">
        <div class="spy-config-method">
          <h4>Torn API Key (Limited Access)</h4>
          <p>Used to fetch live member status (hospital, traveling, jail) during ranked wars. A Limited Access key is required to ensure minimal permissions.</p>
          <p>Your key is stored securely and is never shared with other factions.</p>
        </div>
        <div class="spy-config-method">
          <h4>TornStats API Key</h4>
          <p>Used to import spy reports (battle stats) for enemy factions via TornStats. This allows your faction to view estimated strength, defense, speed, and dexterity of opponents.</p>
        </div>
      </div>
    </details>
  </div>
</div>

<!-- Section 2: War Polling & Import Spy Stats (side by side) -->
<div class="settings-section">
  <div class="settings-top-grid settings-top-grid-stretch">
    <div class="settings-grid-column">
      <h2>War Polling</h2>
      <p class="settings-section-description">Automatically starts when an active ranked war is detected. Feeds live enemy status data to the war dashboard and userscript.</p>

      <div class="api-key-card settings-grid-card">
        <% if @war_polling_active %>
          <div class="war-polling-active-indicator">
            <span class="connection-dot connected"></span>
            <span>Polling is active &mdash; updating every 6 seconds.</span>
          </div>
          <%= button_to "Stop Polling", stop_faction_war_polling_path(@faction), method: :delete, class: "btn-small btn-small-danger", data: { turbo_confirm: "Stop war polling? It will restart automatically next time the dashboard is visited during an active war." } %>
        <% else %>
          <p class="api-key-form-hint">Polling is not active. It will start automatically when an active ranked war is detected on the faction dashboard.</p>
        <% end %>
      </div>
    </div>

    <div class="settings-grid-column">
      <h2>Import Spy Stats</h2>
      <p class="settings-section-description">Import spy data from TornStats for an enemy faction. Updates existing reports and adds new ones.</p>

      <div class="api-key-card settings-grid-card">
        <p class="import-spy-count"><%= @spy_report_count %> reports stored
          <% if @spy_report_count > 0 %>
            &middot; <%= link_to "View all", faction_spy_stats_path(@faction), class: "import-spy-link" %>
          <% end %>
        </p>

        <% unless @faction_setting.tornstats_api_key? %>
          <p class="api-key-form-hint">Configure your TornStats API key above before importing.</p>
        <% else %>
          <%= form_with url: import_spies_faction_settings_path(@faction), method: :post do |form| %>
            <div class="api-key-form-inline">
              <%= form.text_field :target_faction_id,
                  class: "api-key-form-input",
                  placeholder: "Enter enemy faction ID",
                  autocomplete: "off",
                  inputmode: "numeric",
                  pattern: "[0-9]*" %>
              <% if @can_import %>
                <%= form.submit "Import", class: "btn-primary" %>
              <% else %>
                <span data-controller="backfill-countdown"
                      data-backfill-countdown-seconds-remaining-value="<%= @seconds_until_import %>">
                  <button type="button" class="btn-secondary" disabled>
                    <span data-backfill-countdown-target="countdown"><%= @seconds_until_import %>s</span>
                  </button>
                </span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Section 3: Dashboard Access & Share Subscription (side by side) -->
<div class="settings-section">
  <div class="settings-top-grid settings-top-grid-stretch">
    <div class="settings-grid-column">
      <h2>Dashboard Access</h2>
      <p class="settings-section-description">Control which faction members can view the faction dashboard, training data, and other faction pages. Only whitelisted members (and admins) have access.</p>

      <div class="api-key-card settings-grid-card">
        <%= turbo_frame_tag "whitelist" do %>
          <%= render "factions/settings/whitelist" %>
        <% end %>
      </div>
    </div>

    <div class="settings-grid-column">
      <h2>Share Subscription</h2>
      <p class="settings-section-description">Share your subscription time evenly across all faction members. Time is deducted from your balance and distributed equally.</p>

      <div class="api-key-card settings-grid-card">
        <div class="import-spy-header">
          <p class="import-spy-description">
            You have <strong><%= @subscription_weeks_remaining %> weeks</strong> remaining.
            Your faction has <strong><%= @faction_member_count %> members</strong>.
          </p>
        </div>

        <% if @subscription_weeks_remaining <= 0 %>
          <p class="api-key-form-hint">You need an active subscription to share time with your faction.</p>
        <% elsif @faction_member_count == 0 %>
          <p class="api-key-form-hint">No faction members found to share with.</p>
        <% else %>
          <% max_steps = @subscription_weeks_remaining / @faction_member_count %>
          <% max_total = max_steps * @faction_member_count %>
          <%= form_with url: share_subscription_faction_settings_path(@faction), method: :post,
              data: { controller: "share-subscription",
                      share_subscription_member_count_value: @faction_member_count,
                      share_subscription_max_total_value: max_total } do |form| %>
            <div class="share-slider-container">
              <%= form.range_field :slider,
                  min: 0,
                  max: max_steps,
                  value: 0,
                  step: 1,
                  class: "share-slider",
                  data: { share_subscription_target: "slider", action: "input->share-subscription#slide" } %>
              <%= form.hidden_field :total_weeks, value: 0, data: { share_subscription_target: "hidden" } %>
              <div class="share-slider-labels">
                <span>0</span>
                <span><%= max_total %> weeks</span>
              </div>
            </div>
            <p class="share-slider-preview" data-share-subscription-target="preview">
              Drag the slider to share subscription time.
            </p>
            <div class="share-slider-action">
              <%= form.submit "Share", class: "btn-primary", disabled: true,
                  data: { share_subscription_target: "submit",
                          turbo_confirm: "Are you sure? This will deduct weeks from your subscription and distribute them to all faction members." } %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
