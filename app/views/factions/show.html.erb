<% if @tracking_disabled %>
  <div class="centered-content">
    <div class="info-card">
      <h2>Stats Tracking Disabled</h2>
      <p>This faction (<strong><%= @faction.name %></strong>) does not have stats tracking enabled.</p>
      <p>Contact an administrator to enable stats tracking for your faction.</p>
    </div>
  </div>
<% else %>
  <% energy_enabled = @energy_target > 0 %>
  <% nerve_enabled = @nerve_target > 0 %>

  <div class="page-header">
    <h1><%= @faction.name %></h1>
    <p class="page-subtitle">Faction dashboard</p>
  </div>

  <!-- Compliance Overview -->
  <div class="dashboard-section">
    <div class="dashboard-section-header">
      <h2>Training Compliance</h2>
      <%= link_to "View full report ->", faction_training_path(@faction), class: "dashboard-section-link" %>
    </div>

    <div class="dashboard-stats-row">
      <div class="dashboard-stat-card dashboard-stat-compliant">
        <span class="dashboard-stat-value"><%= @compliant_count %></span>
        <span class="dashboard-stat-label">Compliant</span>
      </div>
      <div class="dashboard-stat-card dashboard-stat-warning">
        <span class="dashboard-stat-value"><%= @warning_count %></span>
        <span class="dashboard-stat-label">Warning</span>
      </div>
      <div class="dashboard-stat-card dashboard-stat-danger">
        <span class="dashboard-stat-value"><%= @non_compliant_count %></span>
        <span class="dashboard-stat-label">Below Target</span>
      </div>
      <div class="dashboard-stat-card">
        <span class="dashboard-stat-value"><%= @total_members %></span>
        <span class="dashboard-stat-label">Tracked</span>
      </div>
    </div>

    <div class="dashboard-targets">
      <span class="dashboard-target-item">Xanax: <%= @xanax_target %>/day</span>
      <% if energy_enabled %>
        <span class="dashboard-target-divider">&middot;</span>
        <span class="dashboard-target-item">Energy: <%= @energy_target %>/day</span>
      <% end %>
      <% if nerve_enabled %>
        <span class="dashboard-target-divider">&middot;</span>
        <span class="dashboard-target-item">Nerve: <%= @nerve_target %>/day</span>
      <% end %>
    </div>
  </div>

  <!-- Live War -->
  <% if @current_war %>
    <div class="dashboard-section"
         data-controller="war-score"
         data-war-score-our-score-value="<%= @current_war.our_score %>"
         data-war-score-their-score-value="<%= @current_war.their_score %>">
      <div class="dashboard-section-header">
        <h2>
          Ranked War vs <%= @current_war.opponent_faction_name %>
          <span class="ping-dot"><span class="ping-ring"></span></span>
        </h2>
        <%= link_to "View live dashboard ->", faction_ranked_war_path(@faction, @current_war), class: "dashboard-section-link" %>
      </div>

      <div class="war-polling-card">
        <div class="war-polling-scores">
          <span class="war-polling-score war-polling-score--ours" data-war-score-target="ourScore"><%= @current_war.our_score %></span>
          <span class="war-polling-score-divider">&ndash;</span>
          <span class="war-polling-score war-polling-score--theirs" data-war-score-target="theirScore"><%= @current_war.their_score %></span>
          <span class="war-polling-target">/ <%= @current_war.target_score %></span>
        </div>

        <p class="war-polling-status">Live &mdash; scores update automatically.</p>
      </div>
    </div>
  <% end %>

  <!-- Worst Performers -->
  <% if @worst_performers.any? %>
    <div class="dashboard-section">
      <div class="dashboard-section-header">
        <h2>Needs Attention</h2>
      </div>

      <div class="dashboard-mini-table">
        <table>
          <thead>
            <tr>
              <th>Member</th>
              <th>Xanax/day</th>
              <% if energy_enabled %><th>Energy/day</th><% end %>
              <% if nerve_enabled %><th>Nerve/day</th><% end %>
            </tr>
          </thead>
          <tbody>
            <% @worst_performers.each do |row| %>
              <tr class="dashboard-mini-table-row-<%= row[:compliance_level] %>">
                <td>
                  <a href="https://www.torn.com/profiles.php?XID=<%= row[:torn_id] %>" target="_blank" rel="noopener" class="dashboard-member-link"><%= row[:name] %></a>
                </td>
                <td><%= row[:xanax_daily] %></td>
                <% if energy_enabled %><td><%= row[:energy_refills_daily] %></td><% end %>
                <% if nerve_enabled %><td><%= row[:nerve_refills_daily] %></td><% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Quick Links / Coming Soon -->
  <div class="dashboard-section">
    <div class="dashboard-section-header">
      <h2>More Tools</h2>
    </div>

    <div class="feature-cards feature-cards-compact">
      <% if Current.user.admin? %>
        <%= link_to faction_ranked_wars_path(@faction), class: "feature-card feature-card-small" do %>
          <h3>Ranked Wars</h3>
          <p>War history and member performance</p>
        <% end %>
      <% else %>
        <div class="feature-card feature-card-small feature-card-disabled">
          <span class="coming-soon-badge">Coming Soon</span>
          <h3>Ranked Wars</h3>
          <p>War history and member performance</p>
        </div>
      <% end %>

      <% if Current.user.admin? %>
        <%= link_to faction_spy_stats_path(@faction), class: "feature-card feature-card-small" do %>
          <h3>Spy Stats</h3>
          <p>Enemy battle stats and spy reports</p>
        <% end %>
      <% else %>
        <div class="feature-card feature-card-small feature-card-disabled">
          <span class="coming-soon-badge">Coming Soon</span>
          <h3>Spy Stats</h3>
          <p>Enemy battle stats and spy reports</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
