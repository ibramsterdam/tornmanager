<%= link_to "← Back to Leadership", faction_leadership_path(@faction), class: "back-link" %>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-label">Total Calls</div>
    <div class="stat-value"><%= number_with_delimiter(@total_calls) %></div>
  </div>

  <div class="stat-card">
    <div class="stat-label">Calls Today</div>
    <div class="stat-value"><%= number_with_delimiter(@calls_today) %></div>
  </div>

  <div class="stat-card">
    <div class="stat-label">Last 24 Hours</div>
    <div class="stat-value"><%= number_with_delimiter(@calls_last_24h) %></div>
  </div>

  <div class="stat-card">
    <div class="stat-label">Success Rate</div>
    <div class="stat-value">
      <%= @total_calls > 0 ? "#{((@successful_calls.to_f / @total_calls) * 100).round(1)}%" : "N/A" %>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-label">Avg Response Time</div>
    <div class="stat-value"><%= @avg_response_time ? "#{@avg_response_time}ms" : "N/A" %></div>
  </div>

  <div class="stat-card">
    <div class="stat-label">Failed Calls</div>
    <div class="stat-value error-text"><%= number_with_delimiter(@failed_calls) %></div>
  </div>

  <div class="stat-card">
    <div class="stat-label">Peak Rate Today</div>
    <div class="stat-value <%= @peak_rate_today[:rate] >= 60 ? 'error-text' : '' %>">
      <%= @peak_rate_today[:rate] %>/min
    </div>
    <% if @peak_rate_today[:minute_start].present? %>
      <div class="stat-sublabel">at <%= @peak_rate_today[:minute_start] %></div>
    <% end %>
  </div>
</div>

<div class="table-container">
  <h2>Recent API Calls (Last 500)</h2>

  <% if @api_logs.any? %>
    <table>
      <thead>
        <tr>
          <th>TIMESTAMP</th>
          <th>ENDPOINT</th>
          <th>SELECTIONS</th>
          <th>STATUS</th>
          <th>RESPONSE TIME</th>
          <th>ERROR</th>
        </tr>
      </thead>
      <tbody>
        <% @api_logs.each do |log| %>
          <% selections = log.selections.present? ? JSON.parse(log.selections) : {} %>
          <tr class="<%= log.status == 'error' ? 'error-row' : '' %>">
            <td><%= log.created_at.strftime("%d-%m-%Y %H:%M:%S") %></td>
            <td><code><%= log.endpoint %></code></td>
            <td class="selections-cell">
              <% if selections.any? %>
                <% selections.each do |key, value| %>
                  <span class="selection-tag">
                    <strong><%= key %>:</strong>
                    <% if key == "timestamp" && value.is_a?(Integer) %>
                      <%= Time.at(value).utc.strftime("%d-%m-%Y") %>
                    <% else %>
                      <%= value.to_s %>
                    <% end %>
                  </span>
                <% end %>
              <% else %>
                -
              <% end %>
            </td>
            <td>
              <span class="status-badge <%= log.status %>">
                <%= log.status.upcase %>
              </span>
            </td>
            <td><%= log.response_time ? "#{log.response_time}ms" : "N/A" %></td>
            <td><%= log.error_message&.truncate(50) || "-" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No API calls recorded for this faction's key.</p>
  <% end %>
</div>
