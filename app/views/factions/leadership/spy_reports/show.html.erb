<div class="leadership-page">
  <%= link_to "← Back to Leadership", faction_leadership_path(@faction), class: "back-link" %>

  <!-- Import Form -->
  <div class="leadership-import-bar">
    <% unless @faction_setting.tornstats_api_key? %>
      <p class="leadership-import-hint">Configure your TornStats API key in <%= link_to "Settings", faction_leadership_settings_path(@faction) %> to import spy data.</p>
    <% else %>
      <%= form_with url: faction_leadership_spy_imports_path(@faction), method: :post, class: "leadership-import-form" do |form| %>
        <span class="leadership-import-label">Import from TornStats:</span>
        <%= form.text_field :target_faction_id,
            class: "leadership-import-input",
            placeholder: "Enemy faction ID",
            autocomplete: "off",
            inputmode: "numeric",
            pattern: "[0-9]*" %>
        <% if @can_import %>
          <%= form.submit "Import", class: "btn btn-sm btn-primary" %>
        <% else %>
          <span data-controller="backfill-countdown"
                data-backfill-countdown-seconds-remaining-value="<%= @seconds_until_import %>">
            <button type="button" class="btn btn-sm btn-secondary" disabled>
              <span data-backfill-countdown-target="countdown"><%= @seconds_until_import %>s</span>
            </button>
          </span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <!-- Spy Reports Table -->
  <div class="leadership-table-wrapper">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Torn ID</th>
          <th>Strength</th>
          <th>Defense</th>
          <th>Speed</th>
          <th>Dexterity</th>
          <th>Total</th>
          <th>Age</th>
        </tr>
      </thead>
      <tbody>
        <% if @spy_reports.empty? %>
          <tr>
            <td colspan="8" class="table-empty-cell">
              <div class="table-empty">
                <p>No spy reports imported yet.</p>
              </div>
            </td>
          </tr>
        <% else %>
          <% @spy_reports.each_with_index do |report, index| %>
            <tr>
              <td class="spy-stats-rank"><%= index + 1 %></td>
              <td>
                <a href="https://www.torn.com/profiles.php?XID=<%= report.torn_id %>" target="_blank" class="player-link">
                  <%= report.torn_id %>
                </a>
              </td>
              <td class="spy-stats-number"><%= number_with_delimiter(report.strength) %></td>
              <td class="spy-stats-number"><%= number_with_delimiter(report.defense) %></td>
              <td class="spy-stats-number"><%= number_with_delimiter(report.speed) %></td>
              <td class="spy-stats-number"><%= number_with_delimiter(report.dexterity) %></td>
              <td class="spy-stats-number spy-stats-total"><%= number_with_delimiter(report.total) %></td>
              <td class="spy-stats-age"><%= report.spied_at ? time_ago_in_words(report.spied_at) + " ago" : "Unknown" %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
