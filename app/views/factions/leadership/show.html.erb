<% if @tracking_disabled %>
  <div class="centered-content">
    <div class="info-card">
      <h2>Stats Tracking Disabled</h2>
      <p>This faction (<strong><%= @faction.name %></strong>) does not have stats tracking enabled.</p>
      <p>Contact an administrator to enable stats tracking for your faction.</p>
    </div>
  </div>
<% else %>
  <div class="leadership-dashboard leadership-page">
    <%= render "factions/leadership/hero_section" %>
    <%= render "factions/leadership/wars_section" %>
    <%= render "factions/leadership/spies_section" %>
    <%= render "factions/leadership/settings_section" %>
  </div>
<% end %>
