<section class="dashboard-fullpage" id="settings">
  <div class="dashboard-fullpage-content">
    <div class="training-section-header">
      <h2>Settings</h2>
    </div>

    <div class="leadership-settings-grid">
      <!-- API Keys Card -->
      <div class="leadership-settings-card leadership-settings-card-compact">
        <h3>API Configuration</h3>
        
        <!-- Current Keys Display -->
        <div class="leadership-api-current">
          <div class="leadership-api-current-row">
            <div class="leadership-api-current-info">
              <span class="leadership-api-key-label">Torn API Key</span>
              <% if @faction_setting.torn_api_access_type.present? %>
                <span class="leadership-api-key-badge"><%= @faction_setting.torn_api_access_type %></span>
              <% end %>
            </div>
            <div class="leadership-api-current-value">
              <code><%= @torn_api_key_masked || "Not set" %></code>
              <% if @faction_setting.torn_api_key? %>
                <%= button_to delete_torn_key_faction_leadership_path(@faction),
                    method: :delete,
                    class: "leadership-key-delete-btn",
                    data: { turbo_confirm: "Delete the Torn API key?" } do %>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="leadership-api-current-row">
            <div class="leadership-api-current-info">
              <span class="leadership-api-key-label">TornStats API Key</span>
            </div>
            <div class="leadership-api-current-value">
              <code><%= @tornstats_api_key_masked || "Not set" %></code>
              <% if @faction_setting.tornstats_api_key? %>
                <%= button_to delete_tornstats_key_faction_leadership_path(@faction),
                    method: :delete,
                    class: "leadership-key-delete-btn",
                    data: { turbo_confirm: "Delete the TornStats API key?" } do %>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Update Keys Form -->
        <%= form_with model: @faction_setting, url: update_keys_faction_leadership_path(@faction), method: :patch, class: "leadership-api-form" do |form| %>
          <div class="leadership-api-fields">
            <%= form.text_field :torn_api_key,
                class: "leadership-api-input",
                placeholder: "New Torn API key (Limited Access)",
                autocomplete: "off",
                value: "" %>
            <%= form.text_field :tornstats_api_key,
                class: "leadership-api-input",
                placeholder: "New TornStats API key",
                autocomplete: "off",
                value: "" %>
          </div>
          <%= form.submit "Save Keys", class: "btn btn-sm btn-primary" %>
        <% end %>
      </div>

      <!-- War Polling Card -->
      <div class="leadership-settings-card">
        <h3>War Polling</h3>
        <p class="leadership-settings-description">Auto-starts during active ranked wars. Updates enemy status every 6 seconds.</p>
        
        <div class="leadership-polling-status">
          <% if @war_polling_active %>
            <div class="leadership-polling-active">
              <span class="status-dot live"></span>
              <span>Polling active</span>
            </div>
            <%= button_to "Stop", stop_faction_war_polling_path(@faction), 
                method: :delete, 
                class: "btn btn-xs btn-danger", 
                data: { turbo_confirm: "Stop war polling?" } %>
          <% else %>
            <p class="leadership-polling-idle">Polling is idle. Starts automatically during active wars.</p>
          <% end %>
        </div>
      </div>

      <!-- Leadership Access Card -->
      <div class="leadership-settings-card">
        <h3>Leadership Access</h3>
        <p class="leadership-settings-description">Control who can access this dashboard.</p>
        
        <%= turbo_frame_tag "whitelist" do %>
          <%= render "factions/leadership/whitelist" %>
        <% end %>
      </div>

      <!-- Share Subscription Card -->
      <div class="leadership-settings-card">
        <h3>Share Subscription</h3>
        <p class="leadership-settings-description">Share your subscription time with faction members.</p>
        
        <div class="leadership-subscription-info">
          <span>Your balance: <strong><%= pluralize(@subscription_weeks_remaining, "week") %></strong></span>
          <span>Faction members: <strong><%= @faction_member_count %></strong></span>
        </div>

        <% if @subscription_weeks_remaining <= 0 %>
          <p class="leadership-settings-hint">You need an active subscription to share time.</p>
        <% elsif @faction_member_count == 0 %>
          <p class="leadership-settings-hint">No faction members found to share with.</p>
        <% else %>
          <% max_steps = @subscription_weeks_remaining / @faction_member_count %>
          <% max_total = max_steps * @faction_member_count %>
          <%= form_with url: share_subscription_faction_leadership_path(@faction), method: :post,
              data: { controller: "share-subscription",
                      share_subscription_member_count_value: @faction_member_count,
                      share_subscription_max_total_value: max_total } do |form| %>
            <div class="leadership-share-slider">
              <%= form.range_field :slider,
                  min: 0,
                  max: max_steps,
                  value: 0,
                  step: 1,
                  class: "share-slider",
                  data: { share_subscription_target: "slider", action: "input->share-subscription#slide" } %>
              <%= form.hidden_field :total_weeks, value: 0, data: { share_subscription_target: "hidden" } %>
              <div class="leadership-share-labels">
                <span>0</span>
                <span><%= pluralize(max_total, "week") %></span>
              </div>
            </div>
            <p class="leadership-share-preview" data-share-subscription-target="preview">
              Drag to share subscription time.
            </p>
            <%= form.submit "Share", class: "btn btn-primary", disabled: true,
                data: { share_subscription_target: "submit",
                        turbo_confirm: "This will deduct weeks from your subscription. Continue?" } %>
          <% end %>
        <% end %>
      </div>

      <!-- Coming Soon Card -->
      <div class="leadership-settings-card leadership-settings-card-muted">
        <h3>Coming Soon</h3>
        <p class="leadership-settings-description">More features are on the way. Stay tuned for updates.</p>
      </div>

      <!-- Delete Faction Data Card -->
      <div class="leadership-settings-card leadership-settings-card-danger">
        <h3 class="leadership-danger-title">Delete Faction Data</h3>
        <p class="leadership-settings-description">This will permanently delete:</p>
        <ul class="leadership-danger-list">
          <li>All personal stat snapshots for faction members</li>
          <li>All spy reports collected for this faction</li>
          <li>All ranked war history</li>
          <li>The faction API keys</li>
          <li>The leadership whitelist</li>
        </ul>
        <p class="leadership-danger-preserve">
          <strong>Subscription time will NOT be revoked.</strong> Members keep their remaining subscription. You can set up the faction again at any time.
        </p>
        <%= button_to "Delete Collected Data",
            delete_faction_data_faction_leadership_path(@faction),
            method: :delete,
            class: "btn btn-danger",
            data: { turbo_confirm: "Are you sure? This will permanently delete all faction data. This action cannot be undone." } %>
      </div>
    </div>
  </div>
</section>
