<div class="leadership-page">
  <%= link_to "← Back to Leadership", faction_leadership_path(@faction), class: "back-link" %>

  <div class="coverage-stats-grid">
    <div class="coverage-stat-card">
      <div class="coverage-stat-label">Overall Coverage</div>
      <div class="coverage-stat-value">
        <% coverage_class = if @data_coverage_rate >= 90
                              "stat-compliant"
                            elsif @data_coverage_rate >= 70
                              "stat-warning"
                            else
                              "stat-danger"
                            end %>
        <span class="<%= coverage_class %>"><%= @data_coverage_rate %>%</span>
      </div>
    </div>

    <div class="coverage-stat-card">
      <div class="coverage-stat-label">Missing Yesterday</div>
      <div class="coverage-stat-value">
        <% if @data_missing_yesterday > 0 %>
          <span class="stat-danger"><%= @data_missing_yesterday %></span>
        <% else %>
          <span class="stat-compliant">0</span>
        <% end %>
      </div>
    </div>

    <div class="coverage-stat-card">
      <div class="coverage-stat-label">Total Missing Days</div>
      <div class="coverage-stat-value">
        <% if @data_total_missing_days > 0 %>
          <span class="stat-warning"><%= number_with_delimiter(@data_total_missing_days) %></span>
        <% else %>
          <span class="stat-compliant">0</span>
        <% end %>
      </div>
    </div>

    <div class="coverage-stat-card">
      <div class="coverage-stat-label">Tracking Period</div>
      <div class="coverage-stat-value coverage-stat-value-sm"><%= @tracking_start.strftime("%d %b") %> &ndash; <%= @tracking_end.strftime("%d %b %Y") %></div>
    </div>

    <div class="coverage-stat-card">
      <div class="coverage-stat-label">Next Backfill</div>
      <div class="coverage-stat-value coverage-stat-value-sm" data-controller="countdown" data-countdown-target-value="<%= Date.tomorrow.beginning_of_day.change(hour: 3).iso8601 %>">
        <span data-countdown-target="display">--:--:--</span>
      </div>
      <div class="coverage-stat-hint">Daily at 03:00 TCT</div>
    </div>
  </div>

  <div class="table-container coverage-table-container">
    <h2>Members With Gaps (<%= @member_coverage.size %>)</h2>

    <% if @member_coverage.any? %>
      <div class="coverage-table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Member</th>
              <th>Coverage</th>
              <th>Days Present</th>
              <th>Days Missing</th>
            </tr>
          </thead>
          <% @member_coverage.each do |member| %>
            <tbody data-controller="coverage-row">
              <tr class="coverage-member-row" data-action="click->coverage-row#toggle">
                <td>
                  <a href="https://www.torn.com/profiles.php?XID=<%= member[:user].torn_id %>" target="_blank" class="player-link" data-action="click->coverage-row#stopPropagation">
                    <%= member[:user].name %> [<%= member[:user].torn_id %>]
                  </a>
                </td>
                <td>
                  <% rate_class = if member[:rate] >= 90
                                    "stat-compliant"
                                  elsif member[:rate] >= 70
                                    "stat-warning"
                                  else
                                    "stat-danger"
                                  end %>
                  <span class="<%= rate_class %>"><%= member[:rate] %>%</span>
                </td>
                <td><%= member[:existing] %></td>
                <td><span class="stat-danger"><%= member[:missing] %></span></td>
              </tr>
              <tr class="coverage-detail-row" data-coverage-row-target="details" style="display: none;">
                <td colspan="4">
                  <div class="coverage-detail-content">
                    <div class="coverage-missing-dates">
                      <strong>Missing dates:</strong>
                      <div class="coverage-date-tags">
                        <% member[:missing_dates].each do |date| %>
                          <span class="coverage-date-tag"><%= date.strftime("%d-%m-%Y") %></span>
                        <% end %>
                      </div>
                    </div>
                    <div class="coverage-backfill-action" data-coverage-row-target="action">
                      <p class="coverage-backfill-info">
                        <%= member[:missing] * 2 %> API calls needed to fetch <%= member[:missing] %> missing days.
                      </p>
                      <%= button_to "Backfill Now",
                          backfill_user_faction_leadership_data_coverage_path(@faction, user_id: member[:user].id),
                          method: :post,
                          class: "btn btn-sm btn-primary",
                          data: { action: "click->coverage-row#backfill", coverage_row_target: "button" } %>
                    </div>
                    <div class="coverage-backfill-result" data-coverage-row-target="result" style="display: none;"></div>
                  </div>
                </td>
              </tr>
            </tbody>
          <% end %>
        </table>
      </div>
    <% else %>
      <div class="table-empty">
        <p class="table-empty-text">All members have complete coverage!</p>
      </div>
    <% end %>
  </div>
</div>
