#!/usr/bin/env ruby
require_relative "../config/environment"
require "net/http"
require "json"

# CHANNEL_ID = 1490353824169328690
CHANNEL_ID = 1490451144818819193 # test channel

embed = {
  title: "Armoury Update #2",
  color: 0x5865F2,
  description: [
    "Some improvements to the Armoury page!",
    "",
    "**Armoury**",
    "- Per-member stats when expanding a row: Loans, Returns, Blood Bags consumed, Filled, Deposited, Items Used",
    "- Duplicate filter: quickly find members hoarding multiple items in the same slot (Armor, Weapons, or Both)",
    "",
    "If you'd like to see additional member stats pulled from the activity logs (e.g. energy point refills used), let me know in <#1490344856134881383>!"
  ].join("\n")
}

token = Rails.application.credentials.dig(:discord, :bot_token)
abort("Discord bot_token not configured") unless token

uri = URI("https://discord.com/api/v10/channels/#{CHANNEL_ID}/messages")
http = Net::HTTP.new(uri.host, uri.port)
http.use_ssl = true

request = Net::HTTP::Post.new(uri)
request["Authorization"] = "Bot #{token}"
request["Content-Type"] = "application/json"
request.body = { embeds: [embed] }.to_json

puts "Sending announcement..."
response = http.request(request)
puts "Response: #{response.code} #{response.body}"
