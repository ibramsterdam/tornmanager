#!/usr/bin/env bash
set -euo pipefail

# Builds a new public userscript release and stages it for commit.
#
#   bin/publish                      # tm-chats, patch bump (0.3.1 -> 0.3.2)
#   bin/publish minor                # tm-chats, 0.3.1 -> 0.4.0
#   bin/publish 1.2.3                # tm-chats, explicit version
#   bin/publish tm-recruiter         # tm-recruiter, patch bump
#   bin/publish tm-recruiter minor   # tm-recruiter, minor bump

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

SCRIPT="tm-chats"
case "${1:-}" in
  tm-chats|tm-recruiter) SCRIPT="$1"; shift ;;
esac

SRC_DIR="userscripts/$SCRIPT"
ARTIFACT="userscript/$SCRIPT.user.js"

cd "$ROOT/$SRC_DIR"
VERSION=$(npm version "${1:-patch}" --no-git-tag-version)
npm run release --silent

cd "$ROOT"
git add "$SRC_DIR/package.json" "$SRC_DIR/package-lock.json" "$ARTIFACT"

echo
echo "$SCRIPT userscript $VERSION built and staged:"
git diff --cached --stat -- "$SRC_DIR" "$ARTIFACT" | sed 's/^/  /'
echo
echo "Install link: https://github.com/ibramsterdam/tornmanager/raw/main/$ARTIFACT"
echo "Next: commit and push. Deploy the Rails app first if this release needs new API endpoints."
